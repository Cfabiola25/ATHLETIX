---
import '../styles/global.css';
import { SITE_INFO } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `ATHLETIX | Software de Operación y Gestión para Torneos de Fútbol`,
  description = `Athletix y el motor SIGET automatizan fixtures sin cruces, planillas arbitrales digitales y control de sanciones para ligas y complejos deportivos.` 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="torneos de futbol, planillas arbitrales, software para canchas sinteticas, fixture automatico, control de tarjetas, SIGET, Athletix" />

    <!-- Google Fonts: Plus Jakarta Sans (Editorial UI) + JetBrains Mono (Scoreboards & Timers) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#080A0E] text-slate-200 min-h-screen relative flex flex-col font-sans antialiased selection:bg-[#CCFF00] selection:text-black">
    <!-- Top razor hairline line in volt -->
    <div class="w-full h-[2px] bg-[#CCFF00]/80"></div>

    <!-- Main App Container -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>