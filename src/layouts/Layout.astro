---
import '../styles/global.css';
import { SITE_INFO } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `Athletix — Software Profesional para Torneos y Canchas`,
  description = `Organiza torneos de fútbol, fútbol 8 y microfútbol sin complicaciones. Fixtures automáticos sin cruces, planillas digitales móviles y control de sanciones impulsado por el motor SIGET.` 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="software torneos futbol, gestion deportiva, canchas sinteticas, planillas arbitrales digitales, fixture automatico, SIGET, Athletix" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFC] text-[#334155] min-h-screen relative flex flex-col font-sans antialiased selection:bg-emerald-100 selection:text-emerald-900">
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>