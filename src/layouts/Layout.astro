---
import '../styles/global.css';
import { SITE_INFO } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `Athletix — Software Integral de Gestión Deportiva`,
  description = `La plataforma de gestión deportiva diseñada para organizadores de torneos, complejos de canchas y ligas. Fixtures automáticos, control de sanciones y planillas digitales impulsadas por el motor SIGET.` 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="gestión deportiva, software torneos futbol, planillas arbitrales digitales, fixtures automáticos, SIGET, Athletix" />

    <!-- High-End Typography: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0B0D13] text-[#94A3B8] min-h-screen relative flex flex-col font-sans antialiased selection:bg-[#10B981] selection:text-white">
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>