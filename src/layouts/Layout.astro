---
import '../styles/global.css';
import { SITE_INFO } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `Athletix — Software Integral de Gestión Deportiva`,
  description = `Organiza tus torneos con la precisión de un software de primer nivel. Fixtures automáticos, control de sanciones y planilla arbitral móvil con el motor SIGET.` 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#1F1F20] text-[#DCE0E6] min-h-screen relative flex flex-col font-sans antialiased selection:bg-[#2B4C7E] selection:text-white">
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>