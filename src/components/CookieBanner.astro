---
// CookieBanner.astro - Athletix
---

<!-- Floating Cookie Consent Banner -->
<div
  id="athletixCookieBanner"
  class="fixed bottom-0 inset-x-0 z-50 p-4 sm:p-6 transition-all duration-300 transform translate-y-full opacity-0 pointer-events-none"
>
  <div class="max-w-5xl mx-auto rounded-2xl bg-[#0A0A0A]/95 border border-[#1F1F1F] backdrop-blur-md p-5 sm:p-6 shadow-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-5 text-white">
    
    <div class="space-y-1.5 max-w-3xl">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-[#1C2333] text-[#3B82F6] font-bold text-xs border border-[#2B4C7E]/40">
          🍪
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-[#3B82F6]">
          Privacidad y Cookies &middot; Athletix
        </span>
      </div>
      <p class="text-xs sm:text-sm text-[#8F9CAE] leading-relaxed">
        En Athletix utilizamos cookies técnicas esenciales para la navegación segura y cookies de rendimiento para optimizar la gestión deportiva de torneos y clubes. Puedes aceptar todas, mantener solo las necesarias o personalizar tus preferencias. Conoce más en nuestra 
        <a href="/privacy" class="text-white hover:text-[#3B82F6] underline font-semibold transition-colors">Política de Privacidad y Cookies</a>.
      </p>
    </div>

    <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 w-full md:w-auto shrink-0">
      <button
        type="button"
        id="btn-cookie-settings"
        class="btn-corp-secondary w-full sm:w-auto px-4 py-2.5 text-xs font-semibold text-center cursor-pointer"
      >
        Configurar
      </button>
      <button
        type="button"
        id="btn-cookie-essential"
        class="btn-corp-secondary w-full sm:w-auto px-4 py-2.5 text-xs font-semibold text-center cursor-pointer"
      >
        Solo Necesarias
      </button>
      <button
        type="button"
        id="btn-cookie-accept-all"
        class="btn-corp-primary w-full sm:w-auto px-5 py-2.5 text-xs font-bold text-center cursor-pointer"
      >
        Aceptar Todas
      </button>
    </div>

  </div>
</div>

<!-- Modal de Preferencias de Cookies -->
<dialog
  id="athletixCookieSettingsModal"
  class="fixed inset-0 m-auto rounded-2xl p-0 backdrop:bg-black/80 border-0 shadow-2xl max-w-xl w-[min(94vw,34rem)] bg-[#0A0A0A] text-white border border-[#1F1F1F]"
>
  <div class="p-6 sm:p-8 space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-[#1F1F1F]">
      <div class="flex items-center gap-2.5 font-bold text-lg text-white">
        <span>🍪</span>
        <span>Preferencias de Cookies &middot; Athletix</span>
      </div>
      <button
        type="button"
        id="btn-close-cookie-modal"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#8F9CAE] hover:text-white hover:bg-[#1A1A1A] text-xl font-bold transition cursor-pointer"
      >
        &times;
      </button>
    </div>

    <p class="text-xs text-[#8F9CAE] leading-relaxed">
      Administra qué categorías de cookies permites en tu navegador mientras utilizas la plataforma de Athletix.
    </p>

    <div class="space-y-3.5">
      <!-- Técnicas -->
      <div class="p-4 rounded-xl bg-[#000000] border border-[#1F1F1F] flex items-start justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider">Cookies Técnicas y Esenciales</span>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#1C2333] text-[#3B82F6] border border-[#2B4C7E]/40">Obligatorias</span>
          </div>
          <p class="text-[11px] text-[#8F9CAE] leading-relaxed">
            Permiten la navegación segura, el selector de planes comerciales y la sincronización con el motor deportivo SIGET. No se pueden desactivar.
          </p>
        </div>
        <input type="checkbox" checked disabled class="mt-1 size-4 accent-[#3B82F6] opacity-60 cursor-not-allowed">
      </div>

      <!-- Preferencias -->
      <div class="p-4 rounded-xl bg-[#000000] border border-[#1F1F1F] flex items-start justify-between gap-4">
        <div class="space-y-1">
          <span class="text-xs font-bold text-white uppercase tracking-wider">Cookies de Interfaz y Tema</span>
          <p class="text-[11px] text-[#8F9CAE] leading-relaxed">
            Recuerdan tu selección entre Modo Oscuro OLED y Modo Claro, así como la optimización de ahorro de batería.
          </p>
        </div>
        <input type="checkbox" id="athletixCookiePrefToggle" checked class="mt-1 size-4 accent-[#3B82F6] cursor-pointer">
      </div>

      <!-- Rendimiento -->
      <div class="p-4 rounded-xl bg-[#000000] border border-[#1F1F1F] flex items-start justify-between gap-4">
        <div class="space-y-1">
          <span class="text-xs font-bold text-white uppercase tracking-wider">Métricas de Rendimiento</span>
          <p class="text-[11px] text-[#8F9CAE] leading-relaxed">
            Permiten evaluar de manera agregada y 100% anónima la velocidad de carga y módulos más utilizados por organizadores de torneos.
          </p>
        </div>
        <input type="checkbox" id="athletixCookieAnalyticsToggle" checked class="mt-1 size-4 accent-[#3B82F6] cursor-pointer">
      </div>
    </div>

    <div class="pt-4 border-t border-[#1F1F1F] flex flex-col-reverse sm:flex-row items-center justify-between gap-3">
      <a href="/privacy" class="text-xs text-[#3B82F6] hover:underline font-semibold">
        Ver Política Completa
      </a>
      <button
        type="button"
        id="btn-save-cookie-prefs"
        class="btn-corp-primary w-full sm:w-auto px-5 py-2.5 text-xs font-bold text-center cursor-pointer"
      >
        Guardar Preferencias
      </button>
    </div>
  </div>
</dialog>

<script>
  const ATHLETIX_COOKIE_KEY = "athletix_cookie_consent_v1";

  function getConsent() {
    try {
      const raw = localStorage.getItem(ATHLETIX_COOKIE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch (e) {
      return null;
    }
  }

  function saveConsent(prefs) {
    try {
      localStorage.setItem(ATHLETIX_COOKIE_KEY, JSON.stringify({
        ...prefs,
        updatedAt: new Date().toISOString()
      }));
    } catch (e) {}
    hideBanner();
  }

  function showBanner() {
    const banner = document.getElementById("athletixCookieBanner");
    if (banner) {
      banner.classList.remove("translate-y-full", "opacity-0", "pointer-events-none");
      banner.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
    }
  }

  function hideBanner() {
    const banner = document.getElementById("athletixCookieBanner");
    if (banner) {
      banner.classList.add("translate-y-full", "opacity-0", "pointer-events-none");
      banner.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
    }
  }

  function openSettingsModal() {
    const modal = document.getElementById("athletixCookieSettingsModal");
    if (modal) {
      const current = getConsent();
      const prefToggle = document.getElementById("athletixCookiePrefToggle");
      const anaToggle = document.getElementById("athletixCookieAnalyticsToggle");
      if (prefToggle && current) prefToggle.checked = !!current.preferences;
      if (anaToggle && current) anaToggle.checked = !!current.analytics;
      modal.showModal();
    }
  }

  function setup() {
    const consent = getConsent();
    if (!consent) {
      setTimeout(showBanner, 600);
    }

    document.getElementById("btn-cookie-accept-all")?.addEventListener("click", () => {
      saveConsent({ essential: true, preferences: true, analytics: true });
    });

    document.getElementById("btn-cookie-essential")?.addEventListener("click", () => {
      saveConsent({ essential: true, preferences: false, analytics: false });
    });

    document.getElementById("btn-cookie-settings")?.addEventListener("click", openSettingsModal);

    document.getElementById("btn-close-cookie-modal")?.addEventListener("click", () => {
      document.getElementById("athletixCookieSettingsModal")?.close();
    });

    document.getElementById("btn-save-cookie-prefs")?.addEventListener("click", () => {
      const prefToggle = document.getElementById("athletixCookiePrefToggle");
      const anaToggle = document.getElementById("athletixCookieAnalyticsToggle");
      saveConsent({
        essential: true,
        preferences: prefToggle ? prefToggle.checked : true,
        analytics: anaToggle ? anaToggle.checked : true
      });
      document.getElementById("athletixCookieSettingsModal")?.close();
    });

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (target && target.closest(".open-cookie-settings")) {
        e.preventDefault();
        openSettingsModal();
      }
    });

    window.openAthletixCookieSettings = openSettingsModal;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
</script>