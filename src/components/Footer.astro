---
import { LINKS } from '../config';
---

<!-- Pre-Footer Call to Action -->
<section class="py-24 md:py-32 border-t border-[#1F1F1F] bg-[#000000]">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 text-center">
    <div class="card-corporate rounded-3xl p-10 sm:p-16">
      
      <div class="max-w-2xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-[#3B82F6] bg-[#1C2333] border border-[#2B4C7E] px-3 py-1 rounded-full mb-4 inline-block">
          Pruébalo este fin de semana
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white mb-4">
          Comienza a profesionalizar tus torneos hoy.
        </h2>
        <p class="text-sm sm:text-base text-[#8F9CAE] mb-8 leading-relaxed font-normal">
          Configura tu torneo en 5 minutos, genera las llaves y prueba la planilla digital en tu próxima fecha sin compromiso.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <a 
            href={LINKS.register}
            class="btn-corp-primary w-full sm:w-auto px-8 py-3.5 text-sm font-bold text-center"
          >
            Comenzar prueba gratis en SIGET
          </a>
          <a 
            href={LINKS.whatsappContact}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-corp-secondary w-full sm:w-auto px-7 py-3.5 text-sm font-semibold text-center"
          >
            Hablar con un asesor
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Footer (Solid Swiss Corporate) -->
<footer class="border-t border-[#1F1F1F] bg-[#000000] text-[#8F9CAE] text-xs py-14">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand column -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="w-7 h-7 rounded-lg bg-[#2B4C7E] flex items-center justify-center border border-[#3B82F6]/30">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </div>
          <span class="text-base font-bold text-white tracking-tight">Athletix</span>
        </div>
        <p class="text-[#8F9CAE] text-xs leading-relaxed mb-3">
          Software de comercialización, soporte y gestión deportiva para complejos y ligas de fútbol.
        </p>
        <span class="text-[11px] text-slate-300 bg-[#0A0A0A] border border-[#1F1F1F] px-2.5 py-1 rounded-full inline-block font-medium">
          Tecnología del motor SIGET V1
        </span>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="font-bold text-white text-xs uppercase tracking-wider mb-3.5">Navegación</h4>
        <ul class="space-y-2.5 text-[#8F9CAE] text-xs">
          <li><a href="#features" class="hover:text-white transition-colors">Funcionalidades</a></li>
          <li><a href="#preview" class="hover:text-white transition-colors">Demostración en vivo</a></li>
          <li><a href="#pricing" class="hover:text-white transition-colors">Planes y precios</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">Preguntas frecuentes</a></li>
        </ul>
      </div>

      <!-- Platform -->
      <div>
        <h4 class="font-bold text-white text-xs uppercase tracking-wider mb-3.5">Plataforma</h4>
        <ul class="space-y-2.5 text-[#8F9CAE] text-xs">
          <li><a href={LINKS.login} class="hover:text-white transition-colors">Iniciar sesión en SIGET</a></li>
          <li><a href={LINKS.register} class="hover:text-white transition-colors">Crear nuevo torneo</a></li>
          <li><a href={LINKS.whatsappContact} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Soporte a organizadores</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-bold text-white text-xs uppercase tracking-wider mb-3.5">Contacto</h4>
        <ul class="space-y-2.5 text-[#8F9CAE] text-xs">
          <li>
            <a href={LINKS.whatsappContact} target="_blank" rel="noopener noreferrer" class="hover:text-[#3B82F6] transition-colors font-medium">
              WhatsApp: +57 310 889 5042
            </a>
          </li>
          <li>contacto@athletix.co</li>
          <li>Colombia · Cobertura para Latinoamérica</li>
        </ul>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-8 border-t border-[#1F1F1F] flex flex-col sm:flex-row items-center justify-between gap-4 text-[#8F9CAE] text-xs">
      <p>© {new Date().getFullYear()} Athletix. Todos los derechos reservados. Desarrollado con el motor SIGET.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-white transition-colors">Términos de servicio</a>
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Seguridad</a>
      </div>
    </div>
  </div>
</footer>
