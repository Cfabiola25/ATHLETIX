---
const features = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
    tag: "Automatización",
    title: "Generador de Fixtures y Llaves",
    desc: "Crea el calendario de partidos en segundos. Soporta fase de grupos, round-robin (todos contra todos) y playoffs de eliminación directa sin cruces de horarios ni canchas repetidas.",
    accent: "from-emerald-500/20 to-emerald-500/5",
    border: "border-emerald-500/30",
    textAccent: "text-emerald-400"
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />`,
    tag: "En Tiempo Real",
    title: "Tablas de Posiciones Instantáneas",
    desc: "Dile adiós a las fórmulas rotas de Excel. Al registrar un resultado, PJ, PG, PE, PP, GF, GC, Gol Diferencia y Puntos se calculan y publican al instante.",
    accent: "from-cyan-500/20 to-cyan-500/5",
    border: "border-cyan-500/30",
    textAccent: "text-cyan-400"
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />`,
    tag: "Fair Play",
    title: "Control Disciplinario y Tarjetas",
    desc: "Monitoreo riguroso de tarjetas amarillas y rojas. El motor SIGET detecta acumulación y alerta automáticamente si un jugador suspendido intenta ser alineado.",
    accent: "from-amber-500/20 to-amber-500/5",
    border: "border-amber-500/30",
    textAccent: "text-amber-400"
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
    tag: "100% Digital",
    title: "Planilla Arbitral Móvil",
    desc: "Cero papeles mojados o perdidos. Los árbitros o veedores registran incidencias, goles, sustituciones y firmas de capitanes directamente desde el celular.",
    accent: "from-blue-500/20 to-blue-500/5",
    border: "border-blue-500/30",
    textAccent: "text-blue-400"
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
    tag: "Estadísticas",
    title: "Goleadores y Valla Menos Vencida",
    desc: "Motiva a tus jugadores reconociendo a las figuras de la liga. Tablas de artilleros, arqueros destacados y rendimiento individual por categoría.",
    accent: "from-emerald-500/20 to-emerald-500/5",
    border: "border-emerald-500/30",
    textAccent: "text-emerald-400"
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />`,
    tag: "Acceso Público",
    title: "Portal Web para Jugadores y Fans",
    desc: "Tus delegados y fanaticada tienen un enlace directo para consultar resultados y programaciones en tiempo real desde WhatsApp sin necesidad de instalar apps.",
    accent: "from-cyan-500/20 to-cyan-500/5",
    border: "border-cyan-500/30",
    textAccent: "text-cyan-400"
  }
];
---

<section id="features" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-700/80 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span>Arquitectura SIGET V1</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-5">
        Todo lo que necesitas para operar torneos <span class="text-gradient-emerald">como un profesional</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        Elimina el caos administrativo. Automatiza desde el registro de delegados hasta la coronación del campeón con herramientas diseñadas exclusivamente para el fútbol formativo, aficionado y profesional.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((item) => (
        <div class="glass-card rounded-2xl p-7 flex flex-col justify-between relative group hover:border-slate-600 transition-all duration-300">
          <div>
            <!-- Icon + Tag -->
            <div class="flex items-center justify-between mb-5">
              <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${item.accent} border ${item.border} flex items-center justify-center ${item.textAccent}`}>
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
              </div>
              <span class="text-[11px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-full bg-slate-900/80 border border-slate-800 text-slate-400">
                {item.tag}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xl font-bold text-white mb-2.5 group-hover:text-emerald-400 transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800/60 flex items-center gap-2 text-xs font-semibold text-slate-400 group-hover:text-slate-200 transition-colors">
            <span>Incluido en todos los planes</span>
            <svg class="w-3.5 h-3.5 text-emerald-400 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>