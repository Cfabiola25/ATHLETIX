---
const steps = [
  {
    step: "01",
    tag: "Paso 1",
    title: "Configuración rápida",
    desc: "Crea tu torneo en minutos. Inscribe equipos, define categorías (Libre, Veteranos, Femenino) y ajusta tu reglamento de puntaje, tarjetas y desempates.",
    highlight: "Cero fórmulas complejas de Excel",
    mockup: {
      type: "config",
      teams: ["Atlético San Juan", "Deportivo Unión", "Leones FC", "Halcones Sintética"],
      badge: "Categoría Libre — Fútbol 8"
    }
  },
  {
    step: "02",
    tag: "Paso 2",
    title: "Fixture y difusión por WhatsApp",
    desc: "El motor distribuye las fechas automáticamente sin que ningún equipo ni juez quede cruzado en la misma cancha ni horario. Genera un enlace público listo para compartir por WhatsApp.",
    highlight: "Sin reclamos por cruces de horario",
    mockup: {
      type: "fixture",
      match1: { time: "08:00 AM", court: "Cancha 1", teams: "Atl. San Juan vs Halcones" },
      match2: { time: "09:30 AM", court: "Cancha 1", teams: "Dep. Unión vs Leones FC" }
    }
  },
  {
    step: "03",
    tag: "Paso 3",
    title: "En cancha y planilla en vivo",
    desc: "El árbitro o veedor abre la planilla desde su teléfono celular. Registra goles, amonestaciones y firma digital de capitanes. Al pitar el final, la tabla de posiciones ya está actualizada.",
    highlight: "Actas oficiales blindadas en PDF",
    mockup: {
      type: "match",
      timer: "78:42",
      score: "ASJ 2 — 1 DUN",
      status: "Firma de capitanes validada"
    }
  }
];
---

<section id="features" class="py-20 md:py-28 bg-[#F8FAFC] border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-3 py-1 rounded-full mb-3 inline-block">
        Cómo funciona en la vida real
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Del sorteo a la final en tres pasos sencillos.
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
        Olvídate del estrés administrativo de los domingos. Así es como Athletix y el motor SIGET ponen orden en tu campeonato.
      </p>
    </div>

    <!-- 3-Step Narrative Workflow Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {steps.map((item) => (
        <div class="card-clean card-clean-hover rounded-2xl p-7 flex flex-col justify-between relative bg-white">
          <div>
            <!-- Step Badge Header -->
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100">
                {item.tag}
              </span>
              <span class="text-2xl font-black text-slate-300 font-mono">
                {item.step}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xl font-bold text-slate-900 mb-3 tracking-tight">
              {item.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              {item.desc}
            </p>
          </div>

          <!-- Real-Life Mini UI Preview Inside Card -->
          <div class="mt-4 pt-5 border-t border-slate-100">
            {item.mockup.type === 'config' && (
              <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/60 text-xs">
                <div class="flex items-center justify-between text-slate-500 font-medium mb-2.5">
                  <span>Equipos cargados</span>
                  <span class="text-emerald-700 font-semibold">{item.mockup.badge}</span>
                </div>
                <div class="space-y-1.5">
                  {item.mockup.teams.slice(0, 3).map((team) => (
                    <div class="flex items-center justify-between bg-white px-2.5 py-1.5 rounded-lg border border-slate-200/50 text-slate-800 font-medium">
                      <span>{team}</span>
                      <span class="text-emerald-600 text-[11px]">✓ Listo</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {item.mockup.type === 'fixture' && (
              <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/60 text-xs">
                <div class="flex items-center justify-between text-slate-500 font-medium mb-2.5">
                  <span>Fecha 1 — Domingo</span>
                  <span class="text-emerald-700 font-semibold">Cancha 1 Sintética</span>
                </div>
                <div class="space-y-1.5">
                  <div class="bg-white px-2.5 py-2 rounded-lg border border-slate-200/50">
                    <div class="flex justify-between text-[11px] text-slate-400 font-mono">
                      <span>08:00 AM</span>
                      <span class="text-emerald-600 font-semibold">Sin cruce</span>
                    </div>
                    <div class="font-bold text-slate-800 text-xs mt-0.5">Atl. San Juan vs Halcones</div>
                  </div>
                  <div class="bg-white px-2.5 py-2 rounded-lg border border-slate-200/50">
                    <div class="flex justify-between text-[11px] text-slate-400 font-mono">
                      <span>09:30 AM</span>
                      <span class="text-emerald-600 font-semibold">Sin cruce</span>
                    </div>
                    <div class="font-bold text-slate-800 text-xs mt-0.5">Dep. Unión vs Leones FC</div>
                  </div>
                </div>
              </div>
            )}

            {item.mockup.type === 'match' && (
              <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/60 text-xs">
                <div class="flex items-center justify-between text-slate-500 font-medium mb-2.5">
                  <span>Planilla Móvil del Árbitro</span>
                  <span class="text-emerald-700 font-bold font-mono">Min 78'</span>
                </div>
                <div class="bg-white p-3 rounded-lg border border-slate-200/50">
                  <div class="flex items-center justify-between text-slate-900 font-bold text-sm">
                    <span>Atl. San Juan</span>
                    <span class="bg-slate-100 px-2 py-0.5 rounded font-mono">2 — 1</span>
                    <span>Dep. Unión</span>
                  </div>
                  <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                    <span class="text-emerald-600 font-medium">✓ Firmas de capitanes</span>
                    <span>Acta oficial</span>
                  </div>
                </div>
              </div>
            )}

            <div class="mt-4 flex items-center gap-1.5 text-xs font-semibold text-emerald-800">
              <span>●</span>
              <span>{item.highlight}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>