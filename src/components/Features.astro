---
const features = [
  {
    title: "Programación automática de canchas",
    desc: "Organiza fechas completas en segundos. El motor distribuye horarios y canchas evitando cruces y garantizando descanso equilibrado entre equipos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`
  },
  {
    title: "Tablas de posiciones al instante",
    desc: "Cálculo matemático inmediato al registrar cada resultado: puntos, diferencia de gol, partidos jugados y criterios de desempate federativos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />`
  },
  {
    title: "Control disciplinario automatizado",
    desc: "Seguimiento riguroso de tarjetas amarillas y rojas. El sistema bloquea de manera automática a los futbolistas inhabilitados para la siguiente jornada.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />`
  },
  {
    title: "Planilla arbitral digital",
    desc: "Sin papeles rotos ni caligrafía ilegible. Los árbitros registran incidencias desde su teléfono móvil y validan el acta con firmas digitales.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`
  },
  {
    title: "Artilleros y valla menos vencida",
    desc: "Reconoce a los mejores jugadores del torneo. Tablas de goleadores y arqueros destacados actualizadas automáticamente cada fin de semana.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`
  },
  {
    title: "Portal público para jugadores",
    desc: "Comparte un enlace web limpio por WhatsApp donde delegados, hinchas y familias pueden consultar resultados y posiciones en cualquier momento.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />`
  }
];
---

<section id="features" class="py-24 md:py-32 border-t border-[#2D3748] bg-[#14171F]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header (Helvetica Bold) -->
    <div class="max-w-2xl mb-16 md:mb-20">
      <span class="text-xs font-bold uppercase tracking-wider text-[#3B82F6] bg-[#1C2333] border border-[#2B4C7E] px-3 py-1 rounded-full mb-4 inline-block">
        Funcionalidades principales
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white leading-tight">
        Todo lo que necesitas para operar tu liga con total tranquilidad.
      </h2>
      <p class="text-base text-[#8F9CAE] mt-4 leading-relaxed">
        Diseñado para complejos de canchas y ligas independientes que buscan orden, transparencia y rapidez.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((item) => (
        <div class="card-corporate card-corporate-hover rounded-2xl p-8 flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-[#2B4C7E] flex items-center justify-center text-white mb-6 border border-[#3B82F6]/30">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
            </div>

            <h3 class="text-base font-bold text-white mb-2.5 tracking-tight">
              {item.title}
            </h3>

            <p class="text-sm text-[#8F9CAE] leading-relaxed font-normal">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>