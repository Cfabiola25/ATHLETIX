---
import { LINKS } from '../config';

const plans = [
  {
    name: "Torneo Relámpago",
    tag: "Pago único",
    price: "$99.000",
    currency: "COP",
    period: "por torneo",
    desc: "Para copas de fin de semana, torneos relámpago o campeonatos empresariales.",
    popular: false,
    ctaText: "Crear torneo relámpago",
    ctaLink: LINKS.register,
    features: [
      "Hasta 16 equipos participantes",
      "Fixture automático sin cruces de horarios",
      "Tabla de posiciones en tiempo real",
      "Planilla digital básica para jueces",
      "Enlace público de resultados para WhatsApp",
      "Soporte directo"
    ]
  },
  {
    name: "Liga Pro",
    tag: "Recomendado",
    price: "$189.000",
    currency: "COP",
    period: "al mes",
    desc: "Para complejos deportivos con canchas sintéticas y ligas continuas con múltiples categorías.",
    popular: true,
    ctaText: "Comenzar prueba de 14 días",
    ctaLink: LINKS.register,
    features: [
      "Categorías ilimitadas (Libre, Senior, Femenino)",
      "Hasta 48 equipos simultáneos",
      "Bloqueo automático de jugadores sancionados",
      "Goleadores y valla menos vencida en vivo",
      "Acceso móvil ilimitado para árbitros",
      "Descarga de boletines oficiales en PDF",
      "Soporte prioritario por WhatsApp"
    ]
  },
  {
    name: "Corporativo & Ligas",
    tag: "A la medida",
    price: "A convenir",
    currency: "",
    period: "grandes organizaciones",
    desc: "Para ligas departamentales, cajas de compensación y complejos multideportivos.",
    popular: false,
    ctaText: "Hablar con un asesor",
    ctaLink: LINKS.whatsappContact,
    features: [
      "Torneos y categorías sin límite",
      "Dominio web personalizado (ej. tu-liga.com)",
      "Carnetización con código QR para jugadores",
      "Panel para comité disciplinario y apelaciones",
      "Capacitación directa para tus planilleros",
      "Gerente de cuenta dedicado"
    ]
  }
];
---

<section id="pricing" class="py-24 md:py-36 border-t border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-16 md:mb-24">
      <span class="text-xs font-medium text-emerald-400 mb-3 block">
        Planes y precios
      </span>
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-white leading-tight">
        Planes transparentes para cada etapa de tu liga.
      </h2>
      <p class="text-base text-slate-400 mt-4 leading-relaxed">
        Paga únicamente por el torneo que organizas o suscríbete mensualmente si operas un complejo durante todo el año.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      {plans.map((plan) => (
        <div class={`rounded-2xl p-8 flex flex-col justify-between transition-all ${
          plan.popular 
            ? 'ios-surface border-white/20 shadow-2xl relative' 
            : 'ios-surface'
        }`}>
          
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-white tracking-tight">
                {plan.name}
              </h3>
              {plan.popular && (
                <span class="text-[11px] font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full">
                  {plan.tag}
                </span>
              )}
              {!plan.popular && (
                <span class="text-[11px] font-medium text-slate-400 bg-white/[0.04] border border-white/[0.06] px-2.5 py-0.5 rounded-full">
                  {plan.tag}
                </span>
              )}
            </div>

            <p class="text-xs sm:text-sm text-slate-400 min-h-[40px] mb-6 leading-relaxed">
              {plan.desc}
            </p>

            <div class="flex items-baseline gap-1.5 mb-8 pb-6 border-b border-white/[0.06]">
              <span class="text-3xl sm:text-4xl font-semibold text-white tracking-tight tabular-nums">
                {plan.price}
              </span>
              {plan.currency && <span class="text-xs font-medium text-slate-400">{plan.currency}</span>}
              <span class="text-xs text-slate-400">/ {plan.period}</span>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 mb-8 text-xs sm:text-sm text-slate-300">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-3">
                  <span class="text-emerald-400 font-medium">✓</span>
                  <span class="text-slate-300 font-normal">{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA Button -->
          <a 
            href={plan.ctaLink}
            target={plan.popular ? "_self" : "_blank"}
            rel="noopener noreferrer"
            class={`w-full py-3 px-5 rounded-full text-xs sm:text-sm text-center font-medium block transition-all ${
              plan.popular
                ? 'btn-primary'
                : 'btn-secondary'
            }`}
          >
            {plan.ctaText}
          </a>

        </div>
      ))}
    </div>

    <!-- Trust Footnote -->
    <div class="mt-12 text-center text-xs text-slate-400">
      <span>Sin contratos de permanencia. Puedes cancelar o pausar tu suscripción en cualquier momento.</span>
    </div>

  </div>
</section>