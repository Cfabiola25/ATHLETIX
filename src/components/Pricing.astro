---
import { LINKS } from '../config';

const plans = [
  {
    name: "Torneo Relámpago",
    tag: "Pago único",
    price: "$99.000",
    currency: "COP",
    period: "por torneo",
    desc: "Para copas de fin de semana, torneos de microfútbol barriales o campeonatos empresariales.",
    popular: false,
    ctaText: "Crear torneo relámpago",
    ctaLink: LINKS.register,
    features: [
      "Hasta 16 equipos participantes",
      "Fixture automático sin cruces de horarios",
      "Tabla de posiciones en tiempo real",
      "Planilla digital básica para jueces",
      "Enlace público de resultados para WhatsApp",
      "Soporte directo por WhatsApp"
    ]
  },
  {
    name: "Liga Pro",
    tag: "Recomendado",
    price: "$189.000",
    currency: "COP",
    period: "al mes",
    desc: "Para complejos deportivos con canchas sintéticas y ligas continuas con múltiples categorías.",
    popular: true,
    ctaText: "Comenzar prueba gratis de 14 días",
    ctaLink: LINKS.register,
    features: [
      "Categorías ilimitadas (Libre, Veteranos, Femenino)",
      "Hasta 48 equipos simultáneos",
      "Bloqueo automático de jugadores sancionados",
      "Goleadores y valla menos vencida en vivo",
      "Acceso móvil ilimitado para árbitros",
      "Descarga de boletines oficiales en PDF",
      "Soporte prioritario 24/7 por WhatsApp"
    ]
  },
  {
    name: "Corporativo & Ligas",
    tag: "A la medida",
    price: "A convenir",
    currency: "",
    period: "grandes organizaciones",
    desc: "Para ligas departamentales, cajas de compensación y complejos multideportivos de 4+ canchas.",
    popular: false,
    ctaText: "Hablar con un asesor comercial",
    ctaLink: LINKS.whatsappContact,
    features: [
      "Torneos y categorías sin límite",
      "Dominio web personalizado (ej. tu-liga.com)",
      "Carnetización con código QR para jugadores",
      "Panel para comité disciplinario y apelaciones",
      "Capacitación directa para tus planilleros",
      "Gerente de cuenta dedicado"
    ]
  }
];
---

<section id="pricing" class="py-24 md:py-32 border-t border-blue-500/15 relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-16 md:mb-20">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-400 bg-blue-950/60 border border-blue-500/30 px-3 py-1 rounded-full mb-4 inline-block">
        Planes y precios
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
        Planes transparentes para cada etapa de tu liga.
      </h2>
      <p class="text-base text-slate-300 mt-4 leading-relaxed">
        Paga únicamente por el torneo que organizas o suscríbete mensualmente si operas un complejo durante todo el año.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      {plans.map((plan) => (
        <div class={`rounded-2xl p-8 flex flex-col justify-between transition-all card-vivid ${
          plan.popular 
            ? 'border-2 border-blue-500 shadow-2xl shadow-blue-900/40 relative' 
            : 'hover:border-blue-500/40'
        }`}>
          
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-white tracking-tight">
                {plan.name}
              </h3>
              {plan.popular ? (
                <span class="text-[11px] font-bold text-white bg-blue-600 border border-blue-400/50 px-2.5 py-0.5 rounded-full shadow-xs">
                  {plan.tag}
                </span>
              ) : (
                <span class="text-[11px] font-medium text-blue-200 bg-blue-950/50 border border-blue-500/30 px-2.5 py-0.5 rounded-full">
                  {plan.tag}
                </span>
              )}
            </div>

            <p class="text-xs sm:text-sm text-slate-300 min-h-[40px] mb-6 leading-relaxed">
              {plan.desc}
            </p>

            <div class="flex items-baseline gap-1.5 mb-8 pb-6 border-b border-blue-500/15">
              <span class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-mono tabular-nums">
                {plan.price}
              </span>
              {plan.currency && <span class="text-xs font-semibold text-blue-300">{plan.currency}</span>}
              <span class="text-xs text-slate-400 ml-1">/ {plan.period}</span>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 mb-8 text-xs sm:text-sm text-slate-200">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-3">
                  <span class="text-blue-400 font-bold">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA Button -->
          <a 
            href={plan.ctaLink}
            target={plan.popular ? "_self" : "_blank"}
            rel="noopener noreferrer"
            class={`w-full py-3.5 px-5 rounded-full text-xs sm:text-sm text-center font-bold block transition-all ${
              plan.popular
                ? 'btn-pill-light'
                : 'btn-pill-dark'
            }`}
          >
            {plan.ctaText}
          </a>

        </div>
      ))}
    </div>

    <!-- Footnote -->
    <div class="mt-12 text-center text-xs text-slate-400">
      <span>Sin contratos de permanencia. Puedes pausar o cancelar tu suscripción en cualquier momento.</span>
    </div>

  </div>
</section>