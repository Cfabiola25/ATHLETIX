---
import { LINKS } from '../config';

const tiers = [
  {
    name: "Relámpago",
    tag: "Tarifa Plana Única",
    price: "$100,000",
    currency: "COP",
    period: "por torneo",
    duration: "Fin de semana (1 a 3 días)",
    featuresAndDuration: "Fin de semana (1 a 3 días). Hasta 16 equipos.",
    billingModel: "Tarifa Plana Única",
    projectedValue: "$100,000 por torneo",
    estimatedRevenue: "$100,000",
    popular: false,
    ctaText: "Organizar Torneo Relámpago",
    ctaLink: LINKS.register,
    features: [
      "Hasta 16 equipos participantes",
      "Duración de 1 a 3 días (Fin de semana)",
      "Fixture automático sin cruces de horarios",
      "Tabla de posiciones en tiempo real",
      "Planilla digital básica para jueces",
      "Enlace público de resultados para WhatsApp"
    ]
  },
  {
    name: "Liga Amateur",
    tag: "Por Equipo Inscrito",
    price: "$12,000 - $15,000",
    currency: "COP",
    period: "por equipo",
    duration: "1 a 3 meses",
    featuresAndDuration: "1 a 3 meses. Torneo regular (16 a 32 equipos).",
    billingModel: "Por Equipo Inscrito",
    projectedValue: "$12,000 - $15,000 por equipo",
    estimatedRevenue: "$192,000 - $480,000",
    popular: true,
    ctaText: "Comenzar Liga Amateur",
    ctaLink: LINKS.register,
    features: [
      "Torneo regular de 16 a 32 equipos",
      "Duración de 1 a 3 meses de competencia",
      "Cobro por equipo inscrito",
      "Bloqueo automático de jugadores sancionados",
      "Goleadores y valla menos vencida en vivo",
      "Planilla arbitral móvil y boletines en PDF"
    ]
  },
  {
    name: "Mega Torneo",
    tag: "Licencia Extendida",
    price: "$500,000+",
    currency: "COP",
    period: "por temporada",
    duration: "Temporada completa / Varias sedes",
    featuresAndDuration: "Múltiples categorías (ej. libre, veteranos, femenino) / Varias sedes.",
    billingModel: "Licencia Extendida",
    projectedValue: "$500,000+ por temporada",
    estimatedRevenue: "$500,000+",
    popular: false,
    ctaText: "Cotizar Licencia Extendida",
    ctaLink: LINKS.whatsappContact,
    features: [
      "Múltiples categorías (libre, veteranos, femenino)",
      "Gestión simultánea de varias sedes y canchas",
      "Equipos y categorías sin límite",
      "Carnetización con código QR para jugadores",
      "Panel para comité disciplinario y resoluciones",
      "Capacitación presencial/virtual y soporte prioritario"
    ]
  }
];
---

<section id="pricing" class="py-24 md:py-32 border-t border-[#1F1F1F] bg-[#000000]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header (Helvetica) -->
    <div class="max-w-2xl mb-16 md:mb-20">
      <span class="text-xs font-bold uppercase tracking-wider text-[#3B82F6] bg-[#1C2333] border border-[#2B4C7E] px-3 py-1 rounded-full mb-4 inline-block">
        Modelos de Inversión y Proyección
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white leading-tight">
        Tarifas adaptadas al formato de tu torneo.
      </h2>
      <p class="text-base text-[#8F9CAE] mt-4 leading-relaxed">
        Elige el modelo ideal según la magnitud, duración y cantidad de equipos de tu evento deportivo.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch mb-20">
      {tiers.map((plan) => (
        <div class={`rounded-2xl p-8 flex flex-col justify-between transition-all card-corporate ${
          plan.popular 
            ? 'border-2 border-[#3B82F6] relative' 
            : 'border border-[#1F1F1F]'
        }`}>
          
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-white tracking-tight">
                {plan.name}
              </h3>
              {plan.popular ? (
                <span class="text-[11px] font-bold text-white bg-[#2B4C7E] border border-[#3B82F6]/50 px-2.5 py-0.5 rounded-full">
                  {plan.tag}
                </span>
              ) : (
                <span class="text-[11px] font-medium text-slate-300 bg-[#000000] border border-[#1F1F1F] px-2.5 py-0.5 rounded-full">
                  {plan.tag}
                </span>
              )}
            </div>

            <p class="text-xs sm:text-sm text-[#8F9CAE] min-h-[44px] mb-6 leading-relaxed">
              {plan.featuresAndDuration}
            </p>

            <div class="flex items-baseline gap-1.5 mb-4 pb-4 border-b border-[#1F1F1F]">
              <span class="text-2xl sm:text-3xl font-bold text-white tracking-tight font-mono tabular-nums">
                {plan.price}
              </span>
              {plan.currency && <span class="text-xs font-semibold text-slate-400">{plan.currency}</span>}
              <span class="text-xs text-slate-400 ml-1">/ {plan.period}</span>
            </div>

            <!-- Revenue Projection Pill -->
            <div class="bg-[#14171F] border border-[#2D3748] rounded-xl p-3.5 mb-6">
              <div class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mb-1">
                Ingreso Total Estimado
              </div>
              <div class="text-base font-bold text-[#3B82F6] font-mono tabular-nums">
                {plan.estimatedRevenue} <span class="text-xs text-slate-400 font-normal">COP</span>
              </div>
            </div>

            <!-- Features -->
            <ul class="space-y-3 mb-8 text-xs sm:text-sm text-slate-200">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-3">
                  <span class="text-[#3B82F6] font-bold">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA Button -->
          <a 
            href={plan.ctaLink}
            target={plan.popular ? "_self" : "_blank"}
            rel="noopener noreferrer"
            class={`w-full py-3.5 px-5 rounded-full text-xs sm:text-sm text-center font-bold block transition-all ${
              plan.popular
                ? 'btn-corp-primary'
                : 'btn-corp-secondary'
            }`}
          >
            {plan.ctaText}
          </a>

        </div>
      ))}
    </div>

    <!-- Comparative Projection Table -->
    <div class="max-w-6xl mx-auto">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Tabla Comparativa de Proyección
          </h3>
          <p class="text-xs sm:text-sm text-[#8F9CAE] mt-1">
            Resumen detallado de características, modelos de cobro y recaudación estimada.
          </p>
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-[#2D3748] card-corporate">
        <table class="w-full text-left text-xs sm:text-sm text-[#E2E8F0] border-collapse">
          <thead>
            <tr class="bg-[#161B26] border-b border-[#2D3748]">
              <th scope="col" class="py-4 px-5 font-bold text-white uppercase tracking-wider text-[11px]">
                Nivel de Torneo
              </th>
              <th scope="col" class="py-4 px-5 font-bold text-white uppercase tracking-wider text-[11px]">
                Características y Duración
              </th>
              <th scope="col" class="py-4 px-5 font-bold text-white uppercase tracking-wider text-[11px]">
                Modelo de Cobro
              </th>
              <th scope="col" class="py-4 px-5 font-bold text-white uppercase tracking-wider text-[11px]">
                Valor Proyectado (COP)
              </th>
              <th scope="col" class="py-4 px-5 font-bold text-white uppercase tracking-wider text-[11px]">
                Ingreso Total Estimado
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#2D3748]">
            {tiers.map((row) => (
              <tr class={`transition-colors hover:bg-[#202633] ${row.popular ? 'bg-[#1C2333]/30' : ''}`}>
                <td class="py-4 px-5 font-bold text-white whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <span>{row.name}</span>
                    {row.popular && (
                      <span class="text-[10px] font-bold text-[#3B82F6] bg-[#2B4C7E]/40 border border-[#3B82F6]/40 px-2 py-0.5 rounded-full">
                        Popular
                      </span>
                    )}
                  </div>
                </td>
                <td class="py-4 px-5 text-slate-300 max-w-xs leading-relaxed">
                  {row.featuresAndDuration}
                </td>
                <td class="py-4 px-5 text-slate-200 font-medium whitespace-nowrap">
                  <span class="bg-[#14171F] border border-[#2D3748] px-2.5 py-1 rounded-md text-[11px] text-slate-300">
                    {row.billingModel}
                  </span>
                </td>
                <td class="py-4 px-5 font-mono tabular-nums text-white whitespace-nowrap font-semibold">
                  {row.projectedValue}
                </td>
                <td class="py-4 px-5 font-mono tabular-nums text-[#3B82F6] font-bold whitespace-nowrap">
                  {row.estimatedRevenue}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Footnote -->
    <div class="mt-12 text-center text-xs text-slate-400">
      <span>Sin contratos de permanencia ni cobros ocultos. Soporte y acompañamiento continuo para tu organización deportiva.</span>
    </div>

  </div>
</section>

