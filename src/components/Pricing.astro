---
import { LINKS } from '../config';

const plans = [
  {
    name: "Torneo Relámpago",
    tag: "PAGO ÚNICO",
    price: "$99.000",
    currency: "COP",
    period: "por torneo",
    desc: "Para copas de fin de semana, torneos de microfútbol o campeonatos de empresas.",
    popular: false,
    ctaText: "Crear Torneo Relámpago",
    ctaLink: LINKS.register,
    features: [
      "Hasta 16 equipos participantes",
      "Fixture automático sin cruces",
      "Tabla de posiciones en tiempo real",
      "Planilla digital básica",
      "Enlace público de resultados para WhatsApp",
      "Soporte técnico directo"
    ]
  },
  {
    name: "Liga Pro",
    tag: "MÁS POPULAR",
    price: "$189.000",
    currency: "COP",
    period: "al mes (Multicategoría)",
    desc: "Para complejos deportivos con canchas sintéticas y ligas continuas de fin de semana.",
    popular: true,
    ctaText: "Iniciar Prueba de 14 Días",
    ctaLink: LINKS.register,
    features: [
      "Múltiples categorías (Libre, Veteranos, Femenil)",
      "Hasta 48 equipos simultáneos",
      "Bloqueo automático de jugadores sancionados",
      "Goleadores y valla menos vencida en vivo",
      "Acceso móvil para árbitros y planilleros",
      "Descarga de boletines oficiales en PDF",
      "Soporte prioritario por WhatsApp"
    ]
  },
  {
    name: "Corporativo & Ligas",
    tag: "A LA MEDIDA",
    price: "A convenir",
    currency: "",
    period: "Ligas de gran formato",
    desc: "Para asociaciones departamentales, cajas de compensación y complejos de 4+ canchas.",
    popular: false,
    ctaText: "Hablar con Asesor",
    ctaLink: LINKS.whatsappContact,
    features: [
      "Torneos y categorías sin límite",
      "Dominio web personalizado (ej. tu-liga.com)",
      "Carnetización con código QR para jugadores",
      "Panel para comité disciplinario y apelaciones",
      "Capacitación directa para tus planilleros",
      "Soporte dedicado los fines de semana"
    ]
  }
];
---

<section id="pricing" class="py-20 md:py-28 border-b border-[#1E2633] bg-[#080A0E]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Heading -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[#0E121A] border border-[#1E2633] text-[#CCFF00] font-mono text-[11px] font-bold uppercase tracking-wider mb-4">
        <span>PRECIOS Y SUSCRIPCIONES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white leading-tight font-sans">
        Precios justos, sin contratos escondidos.
      </h2>
      <p class="text-base sm:text-lg text-slate-300 mt-4">
        Paga únicamente por el torneo que organizas o suscríbete mensualmente si operas un complejo deportivo todo el año.
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {plans.map((plan) => (
        <div class={`rounded-xl p-7 flex flex-col justify-between ${
          plan.popular 
            ? 'bg-[#0E121A] border-2 border-[#CCFF00] shadow-xl relative' 
            : 'bg-[#0E121A] border border-[#1E2633]'
        }`}>
          
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">
                {plan.tag}
              </span>
              {plan.popular && (
                <span class="text-[10px] font-mono font-black uppercase bg-[#CCFF00] text-black px-2 py-0.5 rounded">
                  RECOMENDADO
                </span>
              )}
            </div>

            <h3 class="text-xl font-black uppercase text-white tracking-tight mb-2">
              {plan.name}
            </h3>

            <p class="text-xs text-slate-400 min-h-[36px] mb-6">
              {plan.desc}
            </p>

            <div class="flex items-baseline gap-1 mb-6 pb-6 border-b border-[#1E2633]">
              <span class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight tabular-nums">
                {plan.price}
              </span>
              {plan.currency && <span class="text-xs text-slate-400 font-mono font-bold">{plan.currency}</span>}
              <span class="text-xs text-slate-400 ml-1">/ {plan.period}</span>
            </div>

            <!-- Features -->
            <ul class="space-y-3 mb-8 text-xs font-medium text-slate-300">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#CCFF00] font-bold font-mono">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Action -->
          <a 
            href={plan.ctaLink}
            target={plan.popular ? "_self" : "_blank"}
            rel="noopener noreferrer"
            class={`w-full py-3.5 px-4 rounded-lg text-xs font-black uppercase tracking-wider text-center block transition-colors ${
              plan.popular
                ? 'btn-volt'
                : 'bg-[#141A24] text-white hover:bg-[#1E2633] border border-[#1E2633]'
            }`}
          >
            {plan.ctaText}
          </a>

        </div>
      ))}
    </div>

    <!-- Footnote -->
    <div class="mt-12 text-center text-xs font-mono text-slate-400">
      <span>● Todos los planes incluyen actualizaciones de seguridad y cálculo automático del motor SIGET.</span>
    </div>

  </div>
</section>