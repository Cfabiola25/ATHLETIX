---
import { LINKS } from '../config';

const plans = [
  {
    name: "Torneo Relámpago",
    tag: "Pago único",
    price: "$99.000",
    currency: "COP",
    period: "por torneo",
    desc: "Para copas de fin de semana, torneos de microfútbol barriales o campeonatos empresariales.",
    popular: false,
    ctaText: "Crear torneo relámpago",
    ctaLink: LINKS.register,
    features: [
      "Hasta 16 equipos participantes",
      "Fixture automático sin cruces de horarios",
      "Tabla de posiciones en tiempo real",
      "Planilla digital básica para jueces",
      "Enlace público de resultados para WhatsApp",
      "Soporte directo por WhatsApp"
    ]
  },
  {
    name: "Liga Pro",
    tag: "Más popular",
    price: "$189.000",
    currency: "COP",
    period: "al mes",
    desc: "Para complejos deportivos con canchas sintéticas y ligas continuas con múltiples categorías.",
    popular: true,
    ctaText: "Comenzar prueba gratis de 14 días",
    ctaLink: LINKS.register,
    features: [
      "Categorías ilimitadas (Libre, Veteranos, Femenino)",
      "Hasta 48 equipos simultáneos",
      "Bloqueo automático de jugadores sancionados",
      "Goleadores y valla menos vencida en vivo",
      "Acceso móvil ilimitado para árbitros",
      "Descarga de boletines oficiales en PDF",
      "Soporte prioritario 24/7 por WhatsApp"
    ]
  },
  {
    name: "Corporativo & Ligas",
    tag: "A la medida",
    price: "A convenir",
    currency: "",
    period: "grandes organizaciones",
    desc: "Para ligas departamentales, cajas de compensación y complejos multideportivos de 4+ canchas.",
    popular: false,
    ctaText: "Hablar con un asesor comercial",
    ctaLink: LINKS.whatsappContact,
    features: [
      "Torneos y categorías sin límite",
      "Dominio web personalizado (ej. tu-liga.com)",
      "Carnetización con código QR para jugadores",
      "Panel para comité disciplinario y apelaciones",
      "Capacitación directa para tus planilleros",
      "Gerente de cuenta dedicado"
    ]
  }
];
---

<section id="pricing" class="py-20 md:py-28 bg-[#F8FAFC] border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-3 py-1 rounded-full mb-3 inline-block">
        Planes transparentes
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Invierte en orden, ahorra horas de discusión.
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
        Paga únicamente por el torneo que organizas o suscríbete mensualmente si operas un complejo deportivo durante todo el año.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      {plans.map((plan) => (
        <div class={`rounded-2xl p-8 flex flex-col justify-between transition-all bg-white ${
          plan.popular 
            ? 'card-clean border-2 border-emerald-600 shadow-xl relative' 
            : 'card-clean'
        }`}>
          
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-slate-900 tracking-tight">
                {plan.name}
              </h3>
              {plan.popular ? (
                <span class="text-[11px] font-bold text-emerald-800 bg-emerald-100/80 px-2.5 py-0.5 rounded-full">
                  {plan.tag}
                </span>
              ) : (
                <span class="text-[11px] font-medium text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-full">
                  {plan.tag}
                </span>
              )}
            </div>

            <p class="text-xs sm:text-sm text-slate-600 min-h-[40px] mb-6 leading-relaxed">
              {plan.desc}
            </p>

            <div class="flex items-baseline gap-1 mb-8 pb-6 border-b border-slate-100">
              <span class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-mono tabular-nums">
                {plan.price}
              </span>
              {plan.currency && <span class="text-xs font-semibold text-slate-500">{plan.currency}</span>}
              <span class="text-xs text-slate-500 ml-1">/ {plan.period}</span>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 mb-8 text-xs sm:text-sm text-slate-700">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-3">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA Button -->
          <a 
            href={plan.ctaLink}
            target={plan.popular ? "_self" : "_blank"}
            rel="noopener noreferrer"
            class={`w-full py-3.5 px-5 rounded-xl text-xs sm:text-sm text-center font-semibold block transition-all ${
              plan.popular
                ? 'btn-green shadow-sm'
                : 'btn-clean'
            }`}
          >
            {plan.ctaText}
          </a>

        </div>
      ))}
    </div>

    <!-- Footnote -->
    <div class="mt-12 text-center text-xs text-slate-500">
      <span>Sin contratos forzosos. Puedes pausar o cancelar tu suscripción en cualquier momento.</span>
    </div>

  </div>
</section>