---
import { LINKS } from '../config';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Announcement Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-semibold mb-6 shadow-inner shadow-emerald-950/40">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="tracking-wide">Tecnología SaaS para Organizadores Deportivos</span>
          <span class="text-slate-600">|</span>
          <span class="text-slate-300 font-medium hidden sm:inline">Motor SIGET V1</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
          Gestiona tus torneos de fútbol sin <span class="text-gradient-emerald">hojas de cálculo ni errores.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 mb-8 max-w-2xl leading-relaxed font-normal">
          <strong class="text-white font-semibold">Athletix</strong> automatiza tablas de posiciones, cruces de llaves, sanciones disciplinarias y planillas arbitrales con la potencia del motor <strong class="text-emerald-400 font-semibold">SIGET</strong>. Dedícate a la cancha, nosotros nos encargamos del fixture.
        </p>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-12">
          <a 
            href={LINKS.register} 
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-gradient-to-r from-emerald-400 via-emerald-300 to-cyan-400 hover:from-emerald-300 hover:to-cyan-300 shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 transform hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>Crear mi primer torneo gratis</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href={LINKS.whatsappContact} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl text-base font-semibold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 hover:border-emerald-500/50 hover:text-white transition-all duration-200"
          >
            <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.168L2 22l4.98-1.309A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.71 0-3.303-.526-4.625-1.424l-.331-.225-2.98.782.796-2.908-.246-.352A7.95 7.95 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
            </svg>
            <span>Hablar con un asesor</span>
          </a>
        </div>

        <!-- Trust Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-8 border-t border-slate-800/80 w-full">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white font-sans tracking-tight">1,500+</div>
            <div class="text-xs text-slate-400 font-medium mt-0.5">Partidos gestionados</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-sans tracking-tight">100%</div>
            <div class="text-xs text-slate-400 font-medium mt-0.5">Fixtures automáticos</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-sans tracking-tight">0</div>
            <div class="text-xs text-slate-400 font-medium mt-0.5">Errores de planillas</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white font-sans tracking-tight">24/7</div>
            <div class="text-xs text-slate-400 font-medium mt-0.5">Soporte WhatsApp</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Sports SaaS Card Mockup -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto w-full max-w-lg">
          
          <!-- Outer Glow Backdrop -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-emerald-500/30 to-cyan-500/30 rounded-3xl blur-2xl opacity-75"></div>
          
          <!-- Main Showcase Dashboard Card -->
          <div class="relative rounded-2xl bg-slate-900/90 border border-slate-700/80 p-6 shadow-2xl backdrop-blur-xl">
            
            <!-- Window Topbar -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-5">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-2 text-xs font-mono text-slate-400">siget.athletix.app/torneo/492</span>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-ping"></span>
                EN VIVO
              </span>
            </div>

            <!-- Tournament Badge -->
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span class="font-bold text-slate-300 uppercase tracking-wider">Copa Élite Clausura 2026</span>
              <span class="text-emerald-400 font-semibold">Fecha 7 • Grupo A</span>
            </div>

            <!-- Scoreboard Match Card -->
            <div class="rounded-xl bg-slate-950/80 border border-slate-800 p-4 mb-4">
              <div class="flex items-center justify-between">
                
                <!-- Team A -->
                <div class="flex items-center gap-3 w-5/12">
                  <div class="w-10 h-10 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center font-bold text-emerald-400 text-sm">
                    ASJ
                  </div>
                  <div>
                    <h4 class="font-bold text-white text-sm leading-tight">Atlético San Juan</h4>
                    <span class="text-[11px] text-slate-400">Local</span>
                  </div>
                </div>

                <!-- Live Score Center -->
                <div class="flex flex-col items-center justify-center w-2/12">
                  <div class="text-2xl font-black text-white tracking-widest px-2.5 py-1 rounded bg-slate-900 border border-slate-700">
                    2 - 1
                  </div>
                  <span class="text-[10px] text-emerald-400 font-bold mt-1">Min 78'</span>
                </div>

                <!-- Team B -->
                <div class="flex items-center justify-end gap-3 w-5/12 text-right">
                  <div>
                    <h4 class="font-bold text-white text-sm leading-tight">Deportivo Unión</h4>
                    <span class="text-[11px] text-slate-400">Visitante</span>
                  </div>
                  <div class="w-10 h-10 rounded-full bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center font-bold text-cyan-400 text-sm">
                    DUN
                  </div>
                </div>

              </div>

              <!-- Events Timeline -->
              <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-300">
                <div class="flex items-center gap-1.5">
                  <span class="text-emerald-400">⚽</span>
                  <span>G. Mendoza 34'</span>
                  <span class="text-emerald-400 ml-2">⚽</span>
                  <span>R. Morales 68'</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span>C. Silva 41'</span>
                  <span class="text-cyan-400">⚽</span>
                  <span class="bg-amber-500 text-slate-950 font-bold px-1 rounded text-[9px] ml-1">TA</span>
                </div>
              </div>
            </div>

            <!-- Mini Live Standing Table Preview -->
            <div class="rounded-xl bg-slate-950/60 border border-slate-800/80 p-3 mb-4">
              <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2 px-1">
                <span>Tabla de Posiciones Grupo A</span>
                <span class="text-[10px] text-emerald-400">Actualizado al instante</span>
              </div>
              <div class="space-y-1.5 text-xs">
                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-slate-200">
                  <span class="font-bold text-emerald-400">1. Atlético San Juan</span>
                  <div class="flex items-center gap-3 font-mono text-[11px]">
                    <span class="text-slate-400">PJ: 7</span>
                    <span class="text-slate-400">DG: +9</span>
                    <span class="font-bold text-white bg-emerald-500/30 px-1.5 py-0.5 rounded">18 pts</span>
                  </div>
                </div>
                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-slate-900/50 text-slate-300">
                  <span class="font-medium text-slate-300">2. Deportivo Unión</span>
                  <div class="flex items-center gap-3 font-mono text-[11px]">
                    <span class="text-slate-400">PJ: 7</span>
                    <span class="text-slate-400">DG: +4</span>
                    <span class="font-bold text-slate-300 px-1.5 py-0.5">14 pts</span>
                  </div>
                </div>
                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-slate-900/50 text-slate-400">
                  <span class="font-medium text-slate-400">3. Leones FC</span>
                  <div class="flex items-center gap-3 font-mono text-[11px]">
                    <span class="text-slate-500">PJ: 6</span>
                    <span class="text-slate-500">DG: +2</span>
                    <span class="font-semibold text-slate-400 px-1.5 py-0.5">11 pts</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Floating Badge for Automation -->
            <div class="flex items-center gap-3 p-2.5 rounded-xl bg-gradient-to-r from-emerald-950/80 to-slate-900 border border-emerald-500/30 text-xs">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center text-emerald-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <p class="font-bold text-white text-[11px] leading-tight">Control Disciplinario Activo</p>
                <p class="text-[10px] text-slate-400">Suspensión automática calculada para la fecha 8</p>
              </div>
              <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-1 rounded border border-emerald-500/20">
                SIGET Sync
              </span>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>