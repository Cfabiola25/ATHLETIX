---
import { LINKS } from '../config';
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-28 text-center overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
    
    <!-- Hero Copy Header: Centered (Exactly matching Image 1 with vibrant lighting) -->
    <div class="max-w-4xl mx-auto mb-16">
      
      <!-- Centered Pill Badge with subtle glow -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full pill-badge-vivid text-xs font-semibold mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/80 animate-pulse"></span>
        <span class="tracking-wide text-white">Gestión de torneos impulsada por SIGET</span>
      </div>

      <!-- Main Headline (Crisp, pure radiant white) -->
      <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-extrabold tracking-tight text-white leading-[1.12] mb-6 font-sans drop-shadow-sm">
        Organiza tus torneos con la precisión de un software de primer nivel.
      </h1>

      <!-- Subtitle (Clear, readable, high vitality) -->
      <p class="text-base sm:text-lg text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed font-normal">
        Athletix simplifica la programación de fechas, el control de sanciones y la planilla arbitral móvil. Elimina el estrés de las hojas de cálculo y los reclamos en la mesa de control.
      </p>

      <!-- Centered Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={LINKS.register} 
          class="btn-pill-light w-full sm:w-auto px-8 py-3.5 rounded-full text-sm font-bold inline-flex items-center justify-center gap-2"
        >
          <span>Comenzar prueba gratis</span>
          <svg class="w-4 h-4 text-[#0D1117]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a 
          href={LINKS.whatsappContact} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-pill-dark w-full sm:w-auto px-7 py-3.5 rounded-full text-sm font-semibold inline-flex items-center justify-center gap-2"
        >
          <span>Hablar con un asesor</span>
        </a>
      </div>

    </div>

    <!-- Live Match Dashboard Card with High Vitality & Contrast -->
    <div class="max-w-4xl mx-auto text-left">
      <div class="card-vivid rounded-2xl p-6 sm:p-8 relative">
        
        <!-- Window Top Bar -->
        <div class="flex items-center justify-between pb-5 mb-6 border-b border-blue-500/15">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block shadow-xs shadow-rose-500/50"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block shadow-xs shadow-amber-500/50"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block shadow-xs shadow-emerald-500/50"></span>
          </div>
          <span class="text-xs font-semibold text-slate-300">
            Copa Élite Clausura — Cancha Central
          </span>
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-900/40 border border-blue-400/40 text-blue-200 text-[11px] font-bold shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shadow-sm shadow-emerald-400"></span>
            <span>En vivo</span>
          </div>
        </div>

        <!-- Scoreboard Unit -->
        <div class="bg-[#0D1117] rounded-xl p-6 mb-6 border border-blue-500/20 shadow-inner">
          <div class="flex items-center justify-between">
            
            <!-- Team Local -->
            <div class="flex items-center gap-3.5 w-5/12">
              <div class="w-11 h-11 rounded-full bg-gradient-to-br from-blue-600 to-blue-800 border border-blue-400/40 flex items-center justify-center font-extrabold text-white text-sm shadow-md shadow-blue-900/40">
                AS
              </div>
              <div>
                <h4 class="font-bold text-white text-base sm:text-lg">Atlético San Juan</h4>
                <p class="text-xs text-blue-300 font-medium">Local</p>
              </div>
            </div>

            <!-- Score Center -->
            <div class="flex flex-col items-center justify-center w-2/12">
              <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight tabular-nums font-mono px-3 py-1 bg-white/[0.04] rounded-lg border border-blue-400/20">
                2 — 1
              </div>
              <span class="text-[12px] font-bold text-blue-400 mt-1.5">
                78' Segunda parte
              </span>
            </div>

            <!-- Team Visitor -->
            <div class="flex items-center justify-end gap-3.5 w-5/12 text-right">
              <div>
                <h4 class="font-bold text-white text-base sm:text-lg">Deportivo Unión</h4>
                <p class="text-xs text-blue-300 font-medium">Visitante</p>
              </div>
              <div class="w-11 h-11 rounded-full bg-gradient-to-br from-indigo-600 to-blue-900 border border-blue-400/30 flex items-center justify-center font-extrabold text-white text-sm shadow-md shadow-blue-900/40">
                DU
              </div>
            </div>

          </div>

          <!-- Incidents -->
          <div class="mt-6 pt-4 border-t border-blue-500/15 flex flex-wrap items-center justify-between text-xs text-slate-300 gap-2">
            <div class="flex items-center gap-2">
              <span class="text-blue-400 font-bold">⚽ Gol</span>
              <span class="text-white font-medium">M. Rodríguez (34', 68')</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-white font-medium">C. Silva (41')</span>
              <span class="text-blue-400 font-bold">Gol ⚽</span>
              <span class="text-slate-500">·</span>
              <span class="text-amber-400 font-semibold">Tarjeta amarilla (52')</span>
            </div>
          </div>
        </div>

        <!-- System Notification -->
        <div class="flex items-center justify-between p-3.5 rounded-xl bg-blue-950/40 border border-blue-500/30 text-xs">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-600/30 text-blue-200 border border-blue-400/30 flex items-center justify-center">
              <svg class="w-4 h-4 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-white">Validación disciplinaria en tiempo real</p>
              <p class="text-blue-200/80 text-[11px]">El sistema previene la alineación de jugadores con suspensiones vigentes.</p>
            </div>
          </div>
          <span class="text-[11px] font-bold text-blue-200 bg-blue-900/50 px-2.5 py-1 rounded-full border border-blue-400/40 hidden sm:inline shadow-xs">
            Protección activa
          </span>
        </div>

      </div>

      <!-- 3 Features under Hero with vibrant cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8">
        <div class="p-5 rounded-2xl card-vivid card-vivid-hover">
          <div class="w-8 h-8 rounded-lg bg-blue-600/25 border border-blue-400/30 flex items-center justify-center text-blue-300 font-bold mb-3 text-xs">
            01
          </div>
          <h4 class="text-sm font-bold text-white mb-1.5">Programación inteligente</h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            Asigna franjas horarias y canchas sin cruces de árbitros ni duplicidad de equipos.
          </p>
        </div>

        <div class="p-5 rounded-2xl card-vivid card-vivid-hover">
          <div class="w-8 h-8 rounded-lg bg-blue-600/25 border border-blue-400/30 flex items-center justify-center text-blue-300 font-bold mb-3 text-xs">
            02
          </div>
          <h4 class="text-sm font-bold text-white mb-1.5">Control de sanciones</h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            Acumulación automática de amarillas y rojas con inhabilitación inmediata en planillas.
          </p>
        </div>

        <div class="p-5 rounded-2xl card-vivid card-vivid-hover">
          <div class="w-8 h-8 rounded-lg bg-blue-600/25 border border-blue-400/30 flex items-center justify-center text-blue-300 font-bold mb-3 text-xs">
            03
          </div>
          <h4 class="text-sm font-bold text-white mb-1.5">Planilla digital móvil</h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            Los jueces registran incidencias desde el celular con firma digital de capitanes.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>