---
import { LINKS } from '../config';
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-28 bg-[#1F1F20] text-center overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Hero Copy Header: Centered (Exactly matching Image 1) -->
    <div class="max-w-4xl mx-auto mb-16">
      
      <!-- Centered Pill Badge (from Image 1) -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.04] border border-[#606D80]/40 text-[#DCE0E6] text-xs font-medium mb-8 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Gestión de torneos impulsada por SIGET</span>
      </div>

      <!-- Main Headline (from Image 1) -->
      <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold tracking-tight text-white leading-[1.12] mb-6 font-sans">
        Organiza tus torneos con la precisión de un software de primer nivel.
      </h1>

      <!-- Subtitle (from Image 1) -->
      <p class="text-base sm:text-lg text-[#DCE0E6]/80 mb-10 max-w-2xl mx-auto leading-relaxed font-normal">
        Athletix simplifica la programación de fechas, el control de sanciones y la planilla arbitral móvil. Elimina el estrés de las hojas de cálculo y los reclamos en la mesa de control.
      </p>

      <!-- Centered Action Buttons (from Image 1) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a 
          href={LINKS.register} 
          class="btn-pill-light w-full sm:w-auto px-7 py-3 rounded-full text-sm font-semibold inline-flex items-center justify-center gap-2 shadow-sm"
        >
          <span>Comenzar prueba gratis</span>
          <svg class="w-4 h-4 text-[#1F1F20]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a 
          href={LINKS.whatsappContact} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-pill-dark w-full sm:w-auto px-6 py-3 rounded-full text-sm font-medium inline-flex items-center justify-center gap-2"
        >
          <span>Hablar con un asesor</span>
        </a>
      </div>

    </div>

    <!-- Interactive Live Match Dashboard Card (Themed with Palette: #1F1F20, #2B4C7E, #567EBB, #606D80, #DCE0E6) -->
    <div class="max-w-4xl mx-auto text-left">
      <div class="bg-[#26272A] rounded-2xl border border-[#606D80]/30 p-6 sm:p-8 shadow-2xl shadow-black/40 relative">
        
        <!-- Window Top Bar -->
        <div class="flex items-center justify-between pb-5 mb-6 border-b border-[#606D80]/20">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-white/[0.12] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-white/[0.12] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-white/[0.12] inline-block"></span>
          </div>
          <span class="text-xs font-medium text-[#DCE0E6]/70">
            Copa Élite Clausura — Cancha Central
          </span>
          <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#2B4C7E]/40 border border-[#567EBB]/40 text-[#DCE0E6] text-[11px] font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>En vivo</span>
          </div>
        </div>

        <!-- Scoreboard Unit -->
        <div class="bg-[#1F1F20] rounded-xl p-6 mb-6 border border-[#606D80]/20">
          <div class="flex items-center justify-between">
            
            <!-- Team Local -->
            <div class="flex items-center gap-3.5 w-5/12">
              <div class="w-11 h-11 rounded-full bg-[#2B4C7E]/60 border border-[#567EBB]/40 flex items-center justify-center font-bold text-white text-sm">
                AS
              </div>
              <div>
                <h4 class="font-bold text-white text-sm sm:text-base">Atlético San Juan</h4>
                <p class="text-xs text-[#A0ABB8]">Local</p>
              </div>
            </div>

            <!-- Score Center -->
            <div class="flex flex-col items-center justify-center w-2/12">
              <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight tabular-nums font-mono">
                2 — 1
              </div>
              <span class="text-[12px] font-medium text-[#567EBB] mt-1">
                78' Segunda parte
              </span>
            </div>

            <!-- Team Visitor -->
            <div class="flex items-center justify-end gap-3.5 w-5/12 text-right">
              <div>
                <h4 class="font-bold text-white text-sm sm:text-base">Deportivo Unión</h4>
                <p class="text-xs text-[#A0ABB8]">Visitante</p>
              </div>
              <div class="w-11 h-11 rounded-full bg-[#2B4C7E]/40 border border-[#567EBB]/30 flex items-center justify-center font-bold text-[#DCE0E6] text-sm">
                DU
              </div>
            </div>

          </div>

          <!-- Incidents -->
          <div class="mt-6 pt-4 border-t border-[#606D80]/20 flex flex-wrap items-center justify-between text-xs text-[#A0ABB8] gap-2">
            <div class="flex items-center gap-2">
              <span class="text-[#567EBB] font-medium">⚽ Gol</span>
              <span class="text-white">M. Rodríguez (34', 68')</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-white">C. Silva (41')</span>
              <span class="text-[#567EBB] font-medium">Gol ⚽</span>
              <span class="text-[#606D80]">·</span>
              <span class="text-amber-400">Tarjeta amarilla (52')</span>
            </div>
          </div>
        </div>

        <!-- System Notification -->
        <div class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.03] border border-[#606D80]/20 text-xs">
          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-lg bg-[#2B4C7E]/50 text-[#DCE0E6] flex items-center justify-center">
              <svg class="w-4 h-4 text-[#567EBB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="font-medium text-white">Validación disciplinaria en tiempo real</p>
              <p class="text-[#A0ABB8] text-[11px]">El sistema previene la alineación de jugadores con suspensiones vigentes.</p>
            </div>
          </div>
          <span class="text-[11px] font-medium text-[#DCE0E6] bg-white/[0.05] px-2.5 py-1 rounded-full border border-[#606D80]/30 hidden sm:inline">
            Protección activa
          </span>
        </div>

      </div>

      <!-- 3 Features under Hero -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8">
        <div class="p-5 rounded-2xl bg-[#26272A] border border-[#606D80]/20">
          <h4 class="text-sm font-semibold text-white mb-1.5">Programación inteligente</h4>
          <p class="text-xs text-[#A0ABB8] leading-relaxed">
            Asigna franjas horarias y canchas sin cruces de árbitros ni duplicidad de equipos.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#26272A] border border-[#606D80]/20">
          <h4 class="text-sm font-semibold text-white mb-1.5">Control de sanciones</h4>
          <p class="text-xs text-[#A0ABB8] leading-relaxed">
            Acumulación automática de amarillas y rojas con inhabilitación inmediata en planillas.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#26272A] border border-[#606D80]/20">
          <h4 class="text-sm font-semibold text-white mb-1.5">Planilla digital móvil</h4>
          <p class="text-xs text-[#A0ABB8] leading-relaxed">
            Los jueces registran incidencias desde el celular con firma digital de capitanes.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>