---
import { LINKS } from '../config';
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 border-b border-[#1E2633]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Editorial Column -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Tactical Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#0E121A] border border-[#1E2633] mb-6">
          <span class="w-2 h-2 bg-[#CCFF00] rounded-none"></span>
          <span class="text-xs font-mono font-bold tracking-widest text-[#CCFF00] uppercase">
            OPERACIÓN DEPORTIVA • MOTOR SIGET
          </span>
        </div>

        <!-- Strong Stadium Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white leading-[1.02] mb-6 font-sans">
          Basta de pelear con <span class="text-[#CCFF00]">planillas arrugadas</span> y horarios cruzados.
        </h1>

        <!-- Direct Raw Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 mb-8 max-w-2xl leading-relaxed">
          Los domingos de torneo no tienen por qué ser una pesadilla. <strong class="text-white font-bold">Athletix</strong> automatiza la asignación de canchas, bloquea automáticamente a jugadores con tarjetas acumuladas y actualiza la tabla en vivo gol a gol. Dedícate a la cancha; nosotros blindamos la administración.
        </p>

        <!-- Direct CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto mb-10">
          <a 
            href={LINKS.register} 
            class="btn-volt inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg text-sm font-black uppercase tracking-wider"
          >
            <span>Crear Mi Primer Torneo</span>
            <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href={LINKS.whatsappContact} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-200 bg-[#0E121A] hover:bg-[#141A24] border border-[#1E2633] hover:border-slate-500 transition-colors"
          >
            <span>Hablar con un Asesor (WhatsApp)</span>
          </a>
        </div>

        <!-- The 3 Real Organizer Pain Points -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-[#1E2633] w-full">
          <div class="p-3.5 rounded-lg bg-[#0E121A] border border-[#1E2633]">
            <div class="text-[#CCFF00] font-mono text-xs font-bold uppercase tracking-wider mb-1">
              [ 01 • FIXTURE ]
            </div>
            <div class="text-xs font-bold text-white uppercase tracking-tight">Cero Cruces de Cancha</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">
              Nunca más programarás dos partidos en el mismo horario.
            </p>
          </div>

          <div class="p-3.5 rounded-lg bg-[#0E121A] border border-[#1E2633]">
            <div class="text-[#CCFF00] font-mono text-xs font-bold uppercase tracking-wider mb-1">
              [ 02 • SANCIONES ]
            </div>
            <div class="text-xs font-bold text-white uppercase tracking-tight">Blindaje de Tarjetas</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">
              El sistema bloquea al jugador con 3 amarillas o roja directa.
            </p>
          </div>

          <div class="p-3.5 rounded-lg bg-[#0E121A] border border-[#1E2633]">
            <div class="text-[#CCFF00] font-mono text-xs font-bold uppercase tracking-wider mb-1">
              [ 03 • PLANILLA ]
            </div>
            <div class="text-xs font-bold text-white uppercase tracking-tight">Acta Digital Móvil</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">
              El árbitro digita desde el celular con firma del capitán.
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column: Solid Tactical Scoreboard (Nike / Linear Style) -->
      <div class="lg:col-span-5 relative">
        <div class="sport-card rounded-xl p-5 border border-[#1E2633] bg-[#0E121A] shadow-2xl">
          
          <!-- Terminal/Status Bar -->
          <div class="flex items-center justify-between border-b border-[#1E2633] pb-3 mb-4 text-xs font-mono">
            <div class="flex items-center gap-2 text-slate-400">
              <span class="w-2 h-2 bg-[#CCFF00]"></span>
              <span class="font-bold text-slate-200 uppercase">CANCHA 2 SINTÉTICA</span>
              <span class="text-slate-600">/</span>
              <span>11:15 AM</span>
            </div>
            <span class="px-2 py-0.5 rounded bg-[#CCFF00]/10 text-[#CCFF00] border border-[#CCFF00]/30 font-bold uppercase text-[10px] tracking-wider">
              EN JUEGO
            </span>
          </div>

          <!-- Electronic Scoreboard Unit -->
          <div class="rounded-lg bg-[#080A0E] border border-[#1E2633] p-4 mb-4">
            
            <div class="flex items-center justify-between">
              <!-- Team Local -->
              <div class="w-5/12">
                <span class="text-[10px] font-mono uppercase text-slate-400 font-bold tracking-wider">LOCAL</span>
                <h3 class="text-base sm:text-lg font-black uppercase text-white leading-tight mt-0.5">
                  ATL. SAN JUAN
                </h3>
                <span class="text-[11px] font-mono text-[#CCFF00]">● 2 Goles</span>
              </div>

              <!-- Score Numbers -->
              <div class="w-2/12 flex items-center justify-center">
                <div class="font-mono text-3xl sm:text-4xl font-black text-white bg-[#141A24] px-3 py-1.5 rounded border border-[#1E2633] tracking-widest tabular-nums">
                  2:1
                </div>
              </div>

              <!-- Team Visitor -->
              <div class="w-5/12 text-right">
                <span class="text-[10px] font-mono uppercase text-slate-400 font-bold tracking-wider">VISITA</span>
                <h3 class="text-base sm:text-lg font-black uppercase text-white leading-tight mt-0.5">
                  DEP. UNIÓN
                </h3>
                <span class="text-[11px] font-mono text-slate-400">● 1 Gol</span>
              </div>
            </div>

            <!-- Stadium Clock & Period -->
            <div class="mt-4 pt-3 border-t border-[#1E2633] flex items-center justify-between text-xs font-mono">
              <div class="flex items-center gap-2">
                <span class="text-slate-400">TIEMPO:</span>
                <span class="text-white font-bold bg-[#141A24] px-2 py-0.5 rounded border border-[#1E2633] tabular-nums">
                  78:42
                </span>
                <span class="text-slate-400 font-sans text-[11px]">2º Tiempo (+3')</span>
              </div>
              <span class="text-slate-400 text-[11px]">Árb: H. Restrepo</span>
            </div>

          </div>

          <!-- Critical Tactical Alert (Real Pain Solved) -->
          <div class="p-3 rounded-lg bg-[#141A24] border border-amber-500/40 mb-4">
            <div class="flex items-start gap-2.5">
              <span class="text-amber-400 text-sm mt-0.5 font-bold">⚠️</span>
              <div class="text-xs">
                <div class="font-bold text-white uppercase tracking-tight flex items-center gap-1.5">
                  <span>Validación Disciplinaria SIGET</span>
                  <span class="text-[9px] font-mono bg-amber-500/20 text-amber-300 px-1 rounded">BLOQUEO ACTIVO</span>
                </div>
                <p class="text-slate-300 text-[11px] mt-0.5 leading-snug">
                  El jugador <strong>#10 C. Valdés (Dep. Unión)</strong> tiene 1 fecha por roja directa. El sistema no permitió su firma en la planilla.
                </p>
              </div>
            </div>
          </div>

          <!-- Real Match Incident Log -->
          <div class="space-y-1.5 font-mono text-[11px] border-t border-[#1E2633] pt-3">
            <div class="flex items-center justify-between text-slate-300 px-2 py-1 rounded bg-[#080A0E] border border-[#1E2633]/50">
              <span class="flex items-center gap-2">
                <span class="text-[#CCFF00]">⚽ GOL</span>
                <span>#9 M. Rodríguez (Atl. San Juan)</span>
              </span>
              <span class="text-slate-400 tabular-nums">64'</span>
            </div>

            <div class="flex items-center justify-between text-slate-300 px-2 py-1 rounded bg-[#080A0E] border border-[#1E2633]/50">
              <span class="flex items-center gap-2">
                <span class="text-amber-400">🟨 AMARILLA</span>
                <span>#4 D. Vélez (3ª Acumulada - Susp. Fecha 9)</span>
              </span>
              <span class="text-slate-400 tabular-nums">71'</span>
            </div>
          </div>

          <!-- Footer Verification Stamp -->
          <div class="mt-4 pt-3 border-t border-[#1E2633] flex items-center justify-between text-[10px] font-mono text-slate-400">
            <span class="flex items-center gap-1">
              <span class="w-1.5 h-1.5 bg-[#CCFF00] rounded-none"></span>
              TABLA ACTUALIZADA EN VIVO
            </span>
            <span class="text-slate-400">ACTA DIGITAL #8491</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>