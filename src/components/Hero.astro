---
import { LINKS } from '../config';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 bg-white border-b border-slate-200/70 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Editorial Copy (Aligned Left, No AI Cliché Centering) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-3 py-1 rounded-full mb-6">
          Gestión de torneos impulsada por SIGET
        </span>

        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-extrabold tracking-tight text-slate-950 leading-[1.12] mb-6 font-sans">
          Organiza tus torneos de fútbol con la tranquilidad de un <span class="text-emerald-700">software profesional.</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 mb-8 max-w-xl leading-relaxed">
          Athletix automatiza la programación de canchas, las planillas digitales y el control estricto de tarjetas amarillas y rojas. Menos discusiones de delegados y cero hojas de cálculo rotas.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto mb-10">
          <a 
            href={LINKS.register} 
            class="btn-green inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-semibold shadow-sm"
          >
            <span>Crear mi primer torneo gratis</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href={LINKS.whatsappContact} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-clean inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-medium"
          >
            <span>Hablar con un asesor</span>
          </a>
        </div>

        <!-- Real Field Guarantees -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-8 border-t border-slate-200/80 w-full text-xs text-slate-600">
          <div class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span>Sin cruces de horarios ni canchas repetidas</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span>Planilla móvil con firma digital de capitanes</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span>Tablas y estadísticas al pitazo final</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Daytime Sports App Card -->
      <div class="lg:col-span-5 relative">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xl shadow-slate-200/60 relative">
          
          <!-- App Header -->
          <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100">
            <div>
              <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Torneo Clausura</span>
              <h3 class="text-sm font-bold text-slate-900">Cancha 2 Sintética — Jornada 7</h3>
            </div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
              En juego · 78'
            </span>
          </div>

          <!-- Scoreboard Unit -->
          <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/70 mb-5">
            <div class="flex items-center justify-between">
              
              <!-- Team Local -->
              <div class="flex items-center gap-3 w-5/12">
                <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center justify-center font-bold text-xs shrink-0">
                  AS
                </div>
                <div>
                  <h4 class="font-bold text-slate-900 text-sm leading-snug">Atlético San Juan</h4>
                  <span class="text-[11px] text-slate-500 font-medium">Local</span>
                </div>
              </div>

              <!-- Live Score Numbers -->
              <div class="flex flex-col items-center justify-center w-2/12">
                <div class="text-3xl font-extrabold text-slate-900 font-mono tracking-tight tabular-nums bg-white px-3 py-1 rounded-lg border border-slate-200 shadow-xs">
                  2 : 1
                </div>
                <span class="text-[10px] text-slate-500 font-medium mt-1">2º Tiempo</span>
              </div>

              <!-- Team Visitor -->
              <div class="flex items-center justify-end gap-3 w-5/12 text-right">
                <div>
                  <h4 class="font-bold text-slate-900 text-sm leading-snug">Deportivo Unión</h4>
                  <span class="text-[11px] text-slate-500 font-medium">Visitante</span>
                </div>
                <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-800 border border-blue-200 flex items-center justify-center font-bold text-xs shrink-0">
                  DU
                </div>
              </div>

            </div>

            <!-- Incidents Timeline -->
            <div class="mt-4 pt-3 border-t border-slate-200/60 flex items-center justify-between text-xs text-slate-600">
              <div class="flex items-center gap-1.5">
                <span>⚽ M. Rodríguez 34', 68'</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span>C. Silva 41' ⚽</span>
                <span class="text-slate-400">·</span>
                <span class="text-amber-600 font-medium">🟨 71'</span>
              </div>
            </div>
          </div>

          <!-- Disciplinary Shield Banner -->
          <div class="p-3.5 rounded-xl bg-emerald-50/80 border border-emerald-200 flex items-start gap-3 text-xs mb-4">
            <span class="text-emerald-700 text-base leading-none">🛡️</span>
            <div>
              <p class="font-semibold text-emerald-950">Validación disciplinaria automática</p>
              <p class="text-emerald-800 text-[11px] mt-0.5 leading-snug">
                El jugador #10 Carlos Valdés (Dep. Unión) tiene suspensión vigente y fue bloqueado de la planilla.
              </p>
            </div>
          </div>

          <!-- Bottom Summary -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
            <span>Árbitro: Hernando Restrepo</span>
            <span class="text-emerald-700 font-semibold">Tabla sincronizada en vivo</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>