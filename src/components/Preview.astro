---
import { LINKS } from '../config';
---

<section id="preview" class="py-24 md:py-32 border-t border-[#1F1F1F] bg-[#000000]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header (Helvetica) -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-[#3B82F6] bg-[#1C2333] border border-[#2B4C7E] px-3 py-1 rounded-full mb-4 inline-block">
        Demostración de la plataforma
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white leading-tight">
        Una experiencia fluida, pensada como una aplicación nativa.
      </h2>
      <p class="text-base text-[#8F9CAE] mt-4 leading-relaxed">
        Tablas sin sobrecarga visual, lectura inmediata de marcadores y acceso instantáneo para el organizador y el cuerpo arbitral.
      </p>
    </div>

    <!-- Segmented Control Bar (Flat Corporate) -->
    <div class="flex items-center gap-1.5 bg-[#0A0A0A] p-1.5 rounded-2xl border border-[#1F1F1F] w-fit mb-8 max-w-full overflow-x-auto">
      <button 
        data-tab="tab-posiciones"
        class="preview-tab-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all text-[#000000] bg-white whitespace-nowrap"
      >
        Tabla de posiciones
      </button>
      <button 
        data-tab="tab-fixture"
        class="preview-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:text-white whitespace-nowrap"
      >
        Programación y fixture
      </button>
      <button 
        data-tab="tab-disciplinario"
        class="preview-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:text-white whitespace-nowrap"
      >
        Control disciplinario
      </button>
      <button 
        data-tab="tab-planilla"
        class="preview-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:text-white whitespace-nowrap"
      >
        Planilla digital
      </button>
    </div>

    <!-- Main Container Card (Solid Flat) -->
    <div class="card-corporate rounded-2xl p-6 sm:p-8">
      
      <!-- TAB 1: Tabla de posiciones -->
      <div id="tab-posiciones" class="preview-panel block">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-[#1F1F1F] gap-3">
          <div>
            <h3 class="text-base font-bold text-white">Torneo Clausura — Categoría Libre</h3>
            <p class="text-xs text-[#8F9CAE] mt-0.5">Grupo A · Criterio de desempate federativo</p>
          </div>
          <span class="text-xs font-semibold text-slate-300 bg-[#000000] px-3 py-1 rounded-full border border-[#1F1F1F] w-fit">
            8 equipos participantes
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="text-[12px] font-bold text-slate-300 border-b border-[#1F1F1F] uppercase tracking-wider">
                <th class="pb-3 px-3 w-12 font-semibold">Pos</th>
                <th class="pb-3 px-3 font-semibold">Club</th>
                <th class="pb-3 px-2 text-center font-semibold">PJ</th>
                <th class="pb-3 px-2 text-center font-semibold">PG</th>
                <th class="pb-3 px-2 text-center font-semibold">PE</th>
                <th class="pb-3 px-2 text-center font-semibold">PP</th>
                <th class="pb-3 px-2 text-center font-semibold">GF</th>
                <th class="pb-3 px-2 text-center font-semibold">GC</th>
                <th class="pb-3 px-2 text-center font-semibold text-[#3B82F6]">DG</th>
                <th class="pb-3 px-4 text-center font-bold text-white">PTS</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#1F1F1F]/60">
              
              <!-- Row 1 -->
              <tr class="group hover:bg-[#232936] transition-colors bg-[#1C2333]/50">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-[#2B4C7E] text-white flex items-center justify-center font-bold text-xs">
                    1
                  </span>
                </td>
                <td class="py-3.5 px-3 font-bold text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#2B4C7E] flex items-center justify-center text-[10px] font-bold text-white">
                      AS
                    </span>
                    <span>Atlético San Juan</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">7</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">6</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">0</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono">18</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">5</td>
                <td class="py-3.5 px-2 text-center font-bold text-[#3B82F6] tabular-nums font-mono">+13</td>
                <td class="py-3.5 px-4 text-center font-extrabold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-[#2B4C7E] text-white">18</span>
                </td>
              </tr>

              <!-- Row 2 -->
              <tr class="group hover:bg-[#232936] transition-colors bg-[#1C2333]/50">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-[#2B4C7E] text-white flex items-center justify-center font-bold text-xs">
                    2
                  </span>
                </td>
                <td class="py-3.5 px-3 font-bold text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#1F2937] border border-[#1F1F1F] flex items-center justify-center text-[10px] font-bold text-slate-200">
                      DU
                    </span>
                    <span>Deportivo Unión</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">7</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">4</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono">14</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">8</td>
                <td class="py-3.5 px-2 text-center font-bold text-[#3B82F6] tabular-nums font-mono">+6</td>
                <td class="py-3.5 px-4 text-center font-extrabold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-[#2B4C7E] text-white">14</span>
                </td>
              </tr>

              <!-- Row 3 -->
              <tr class="group hover:bg-[#232936] transition-colors">
                <td class="py-3.5 px-3 text-slate-400 font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">3</span>
                </td>
                <td class="py-3.5 px-3 font-semibold text-slate-200">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#1F2937] border border-[#1F1F1F] flex items-center justify-center text-[10px] font-bold text-slate-300">
                      LN
                    </span>
                    <span>Leones del Norte</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">3</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">11</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">9</td>
                <td class="py-3.5 px-2 text-center font-medium text-slate-300 tabular-nums font-mono">+2</td>
                <td class="py-3.5 px-4 text-center font-bold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-[#000000] border border-[#1F1F1F]">11</span>
                </td>
              </tr>

              <!-- Row 4 -->
              <tr class="group hover:bg-[#232936] transition-colors">
                <td class="py-3.5 px-3 text-slate-400 font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">4</span>
                </td>
                <td class="py-3.5 px-3 font-semibold text-slate-200">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#1F2937] border border-[#1F1F1F] flex items-center justify-center text-[10px] font-bold text-slate-300">
                      HF
                    </span>
                    <span>Halcones Sintética</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">4</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">9</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">14</td>
                <td class="py-3.5 px-2 text-center font-medium text-rose-400 tabular-nums font-mono">-5</td>
                <td class="py-3.5 px-4 text-center font-bold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-[#000000] border border-[#1F1F1F]">07</span>
                </td>
              </tr>

            </tbody>
          </table>
        </div>

        <div class="mt-5 pt-4 border-t border-[#1F1F1F] flex items-center justify-between text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#3B82F6]"></span>
            <span class="font-medium text-white">Clasificación directa a semifinales</span>
          </div>
          <span class="text-slate-400">Actualización en tiempo real vía SIGET</span>
        </div>
      </div>

      <!-- TAB 2: Programación / Fixture -->
      <div id="tab-fixture" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-[#1F1F1F]">
          <div>
            <h3 class="text-base font-bold text-white">Programación — Próximo domingo</h3>
            <p class="text-xs text-[#8F9CAE] mt-0.5">Asignación automática de canchas y jueces</p>
          </div>
          <span class="text-xs font-semibold text-white bg-[#000000] px-3 py-1 rounded-full border border-[#1F1F1F]">
            Jornada 8
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-[#000000] border border-[#1F1F1F]">
            <div class="flex items-center justify-between text-xs text-slate-300 mb-3">
              <span class="font-bold text-white">09:00 AM · Cancha Central</span>
              <span class="text-[#3B82F6] font-semibold bg-[#0A0A0A] px-2 py-0.5 rounded border border-[#1F1F1F]">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-bold text-white text-sm">
              <span>Atlético San Juan</span>
              <span class="text-slate-400 text-xs">vs</span>
              <span>Halcones Sintética</span>
            </div>
            <div class="mt-3 pt-3 border-t border-[#1F1F1F] flex items-center justify-between text-xs text-slate-300">
              <span>Juez: Carlos Rodríguez</span>
              <span class="text-[#3B82F6] font-medium">Planilla lista</span>
            </div>
          </div>

          <div class="p-5 rounded-xl bg-[#000000] border border-[#1F1F1F]">
            <div class="flex items-center justify-between text-xs text-slate-300 mb-3">
              <span class="font-bold text-white">10:45 AM · Cancha Central</span>
              <span class="text-[#3B82F6] font-semibold bg-[#0A0A0A] px-2 py-0.5 rounded border border-[#1F1F1F]">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-bold text-white text-sm">
              <span>Deportivo Unión</span>
              <span class="text-slate-400 text-xs">vs</span>
              <span>Leones del Norte</span>
            </div>
            <div class="mt-3 pt-3 border-t border-[#1F1F1F] flex items-center justify-between text-xs text-slate-300">
              <span>Juez: Mario Pardo</span>
              <span class="text-[#3B82F6] font-medium">Planilla lista</span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: Control Disciplinario -->
      <div id="tab-disciplinario" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-[#1F1F1F]">
          <div>
            <h3 class="text-base font-bold text-white">Sanciones y tarjetas</h3>
            <p class="text-xs text-[#8F9CAE] mt-0.5">Inhabilitación automática para la siguiente fecha</p>
          </div>
          <span class="text-xs font-semibold text-rose-300 bg-rose-950/60 px-3 py-1 rounded-full border border-rose-800">
            2 inhabilitaciones vigentes
          </span>
        </div>

        <div class="space-y-3">
          <div class="p-4 rounded-xl bg-[#000000] border border-[#1F1F1F] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-rose-900/60 border border-rose-700 text-rose-200 flex items-center justify-center text-sm font-bold">
                R
              </span>
              <div>
                <h4 class="text-sm font-bold text-white">Carlos Valdés (#10)</h4>
                <p class="text-xs text-slate-300">Deportivo Unión · Expulsión directa</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold text-rose-300 bg-rose-950/70 px-2.5 py-1 rounded-full border border-rose-800">
                2 fechas pendientes
              </span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#000000] border border-[#1F1F1F] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-amber-900/60 border border-amber-700 text-amber-200 flex items-center justify-center text-sm font-bold">
                A
              </span>
              <div>
                <h4 class="text-sm font-bold text-white">Javier Arango (#5)</h4>
                <p class="text-xs text-slate-300">Halcones Sintética · Acumulación de 3 tarjetas amarillas</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold text-amber-300 bg-amber-950/70 px-2.5 py-1 rounded-full border border-amber-800">
                1 fecha de suspensión
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 4: Planilla digital -->
      <div id="tab-planilla" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-[#1F1F1F]">
          <div>
            <h3 class="text-base font-bold text-white">Planilla arbitral móvil</h3>
            <p class="text-xs text-[#8F9CAE] mt-0.5">Diseñada para captura rápida desde el celular del árbitro</p>
          </div>
          <span class="text-xs font-semibold text-white bg-[#0A0A0A] px-3 py-1 rounded-full border border-[#1F1F1F]">
            Acta abierta
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-xl bg-[#000000] border border-[#1F1F1F]">
            <span class="text-xs text-slate-300 block mb-1">Tiempo de juego</span>
            <div class="text-2xl font-bold text-white tabular-nums font-mono">78:42</div>
            <span class="text-xs text-[#3B82F6] font-semibold mt-1 block">+3' tiempo de adición</span>
          </div>

          <div class="p-5 rounded-xl bg-[#000000] border border-[#1F1F1F]">
            <span class="text-xs text-slate-300 block mb-1">Firmas de capitanes</span>
            <div class="text-sm font-bold text-white mt-2 flex items-center gap-2">
              <span class="text-[#3B82F6] font-bold">✓</span> Local
              <span class="text-[#3B82F6] font-bold ml-2">✓</span> Visitante
            </div>
            <span class="text-xs text-slate-400 mt-1 block">Validado con código de seguridad</span>
          </div>

          <div class="p-5 rounded-xl bg-[#000000] border border-[#1F1F1F]">
            <span class="text-xs text-slate-300 block mb-1">Cierre de encuentro</span>
            <div class="text-sm font-bold text-white mt-2">Exportar boletín oficial</div>
            <span class="text-xs text-slate-400 mt-1 block">Generación automática en PDF</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.preview-tab-btn');
  const panels = document.querySelectorAll('.preview-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      tabBtns.forEach(b => {
        b.classList.remove('active', 'text-[#000000]', 'bg-white');
        b.classList.add('text-slate-300');
      });

      btn.classList.add('active', 'text-[#000000]', 'bg-white');
      btn.classList.remove('text-slate-300');

      panels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });
</script>
