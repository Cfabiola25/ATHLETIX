---
import { LINKS } from '../config';
---

<section id="preview" class="py-24 md:py-36 border-t border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-medium text-emerald-400 mb-3 block">
        Demostración de la plataforma
      </span>
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-white leading-tight">
        Una experiencia fluida, pensada como una aplicación nativa.
      </h2>
      <p class="text-base text-slate-400 mt-4 leading-relaxed">
        Tablas sin sobrecarga visual, lectura inmediata de marcadores y acceso instantáneo para el organizador y el cuerpo arbitral.
      </p>
    </div>

    <!-- Segmented Control Bar (Apple Style) -->
    <div class="flex items-center gap-1 bg-[#0E1017] p-1 rounded-xl border border-white/[0.06] w-fit mb-8 max-w-full overflow-x-auto">
      <button 
        data-tab="tab-posiciones"
        class="preview-tab-btn active px-4 py-2 rounded-lg text-xs font-medium transition-all text-white bg-[#1E2330] shadow-sm whitespace-nowrap"
      >
        Tabla de posiciones
      </button>
      <button 
        data-tab="tab-fixture"
        class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-medium transition-all text-slate-400 hover:text-white whitespace-nowrap"
      >
        Programación y fixture
      </button>
      <button 
        data-tab="tab-disciplinario"
        class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-medium transition-all text-slate-400 hover:text-white whitespace-nowrap"
      >
        Control disciplinario
      </button>
      <button 
        data-tab="tab-planilla"
        class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-medium transition-all text-slate-400 hover:text-white whitespace-nowrap"
      >
        Planilla digital
      </button>
    </div>

    <!-- Main Native Window Container (iOS / macOS App Style) -->
    <div class="ios-surface rounded-2xl p-6 sm:p-8 shadow-xl">
      
      <!-- TAB 1: Tabla de posiciones impecable -->
      <div id="tab-posiciones" class="preview-panel block">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-white/[0.06] gap-3">
          <div>
            <h3 class="text-base font-semibold text-white">Torneo Clausura — Categoría Libre</h3>
            <p class="text-xs text-slate-400 mt-0.5">Grupo A · Criterio de desempate federativo</p>
          </div>
          <span class="text-xs font-medium text-slate-400 bg-white/[0.04] px-3 py-1 rounded-full border border-white/[0.06] w-fit">
            8 equipos participantes
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="text-[12px] font-medium text-slate-400 border-b border-white/[0.06]">
                <th class="pb-3 px-3 w-12 font-normal">Pos</th>
                <th class="pb-3 px-3 font-normal">Club</th>
                <th class="pb-3 px-2 text-center font-normal">PJ</th>
                <th class="pb-3 px-2 text-center font-normal">PG</th>
                <th class="pb-3 px-2 text-center font-normal">PE</th>
                <th class="pb-3 px-2 text-center font-normal">PP</th>
                <th class="pb-3 px-2 text-center font-normal">GF</th>
                <th class="pb-3 px-2 text-center font-normal">GC</th>
                <th class="pb-3 px-2 text-center font-normal">DG</th>
                <th class="pb-3 px-4 text-center font-medium text-white">PTS</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04]">
              
              <!-- Row 1 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-medium text-xs">
                    1
                  </span>
                </td>
                <td class="py-3.5 px-3 font-medium text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-white/[0.06] flex items-center justify-center text-[10px] font-semibold text-slate-300">
                      AS
                    </span>
                    <span>Atlético San Juan</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums">7</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums">6</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">0</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">1</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums">18</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">5</td>
                <td class="py-3.5 px-2 text-center font-medium text-emerald-400 tabular-nums">+13</td>
                <td class="py-3.5 px-4 text-center font-semibold text-white tabular-nums">
                  <span class="px-2 py-0.5 rounded-md bg-white/[0.06]">18</span>
                </td>
              </tr>

              <!-- Row 2 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-medium text-xs">
                    2
                  </span>
                </td>
                <td class="py-3.5 px-3 font-medium text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-white/[0.06] flex items-center justify-center text-[10px] font-semibold text-slate-300">
                      DU
                    </span>
                    <span>Deportivo Unión</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums">7</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums">4</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">1</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums">14</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">8</td>
                <td class="py-3.5 px-2 text-center font-medium text-emerald-400 tabular-nums">+6</td>
                <td class="py-3.5 px-4 text-center font-semibold text-white tabular-nums">
                  <span class="px-2 py-0.5 rounded-md bg-white/[0.06]">14</span>
                </td>
              </tr>

              <!-- Row 3 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3 text-slate-400 font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">3</span>
                </td>
                <td class="py-3.5 px-3 font-medium text-slate-200">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-white/[0.06] flex items-center justify-center text-[10px] font-semibold text-slate-400">
                      LN
                    </span>
                    <span>Leones del Norte</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">7</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">3</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">11</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">9</td>
                <td class="py-3.5 px-2 text-center font-medium text-slate-300 tabular-nums">+2</td>
                <td class="py-3.5 px-4 text-center font-medium text-slate-200 tabular-nums">11</td>
              </tr>

              <!-- Row 4 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3 text-slate-400 font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">4</span>
                </td>
                <td class="py-3.5 px-3 font-medium text-slate-200">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-white/[0.06] flex items-center justify-center text-[10px] font-semibold text-slate-400">
                      HF
                    </span>
                    <span>Halcones Sintética</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">7</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">1</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">4</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">9</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums">14</td>
                <td class="py-3.5 px-2 text-center font-medium text-rose-400 tabular-nums">-5</td>
                <td class="py-3.5 px-4 text-center font-medium text-slate-200 tabular-nums">07</td>
              </tr>

            </tbody>
          </table>
        </div>

        <div class="mt-5 pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Clasificación directa a semifinales</span>
          </div>
          <span>Actualización en tiempo real vía SIGET</span>
        </div>
      </div>

      <!-- TAB 2: Programación / Fixture -->
      <div id="tab-fixture" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-white/[0.06]">
          <div>
            <h3 class="text-base font-semibold text-white">Programación — Próximo domingo</h3>
            <p class="text-xs text-slate-400 mt-0.5">Asignación automática de canchas y jueces</p>
          </div>
          <span class="text-xs font-medium text-slate-300 bg-white/[0.04] px-3 py-1 rounded-full border border-white/[0.06]">
            Jornada 8
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span>09:00 AM · Cancha Central</span>
              <span class="text-emerald-400 font-medium">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-medium text-white text-sm">
              <span>Atlético San Juan</span>
              <span class="text-slate-500 text-xs">vs</span>
              <span>Halcones Sintética</span>
            </div>
            <div class="mt-3 pt-3 border-t border-white/[0.04] flex items-center justify-between text-xs text-slate-400">
              <span>Juez: Carlos Rodríguez</span>
              <span>Planilla lista</span>
            </div>
          </div>

          <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span>10:45 AM · Cancha Central</span>
              <span class="text-emerald-400 font-medium">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-medium text-white text-sm">
              <span>Deportivo Unión</span>
              <span class="text-slate-500 text-xs">vs</span>
              <span>Leones del Norte</span>
            </div>
            <div class="mt-3 pt-3 border-t border-white/[0.04] flex items-center justify-between text-xs text-slate-400">
              <span>Juez: Mario Pardo</span>
              <span>Planilla lista</span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: Control Disciplinario -->
      <div id="tab-disciplinario" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-white/[0.06]">
          <div>
            <h3 class="text-base font-semibold text-white">Sanciones y tarjetas</h3>
            <p class="text-xs text-slate-400 mt-0.5">Inhabilitación automática para la siguiente fecha</p>
          </div>
          <span class="text-xs font-medium text-rose-400 bg-rose-500/10 px-3 py-1 rounded-full border border-rose-500/20">
            2 inhabilitaciones vigentes
          </span>
        </div>

        <div class="space-y-3">
          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.06] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center text-sm font-semibold">
                R
              </span>
              <div>
                <h4 class="text-sm font-medium text-white">Carlos Valdés (#10)</h4>
                <p class="text-xs text-slate-400">Deportivo Unión · Expulsión directa</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-medium text-rose-400 bg-rose-500/10 px-2.5 py-1 rounded-full border border-rose-500/20">
                2 fechas pendientes
              </span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.06] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-sm font-semibold">
                A
              </span>
              <div>
                <h4 class="text-sm font-medium text-white">Javier Arango (#5)</h4>
                <p class="text-xs text-slate-400">Halcones Sintética · Acumulación de 3 tarjetas amarillas</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-medium text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20">
                1 fecha de suspensión
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 4: Planilla digital -->
      <div id="tab-planilla" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-white/[0.06]">
          <div>
            <h3 class="text-base font-semibold text-white">Planilla arbitral móvil</h3>
            <p class="text-xs text-slate-400 mt-0.5">Diseñada para captura rápida desde el celular del árbitro</p>
          </div>
          <span class="text-xs font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
            Acta abierta
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
            <span class="text-xs text-slate-400 block mb-1">Tiempo de juego</span>
            <div class="text-2xl font-semibold text-white tabular-nums">78:42</div>
            <span class="text-xs text-emerald-400 mt-1 block">+3' tiempo de adición</span>
          </div>

          <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
            <span class="text-xs text-slate-400 block mb-1">Firmas de capitanes</span>
            <div class="text-sm font-medium text-white mt-2 flex items-center gap-2">
              <span class="text-emerald-400">✓</span> Local
              <span class="text-emerald-400 ml-2">✓</span> Visitante
            </div>
            <span class="text-xs text-slate-500 mt-1 block">Validado con código de seguridad</span>
          </div>

          <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
            <span class="text-xs text-slate-400 block mb-1">Cierre de encuentro</span>
            <div class="text-sm font-medium text-emerald-400 mt-2">Exportar boletín oficial</div>
            <span class="text-xs text-slate-500 mt-1 block">Generación automática en PDF</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.preview-tab-btn');
  const panels = document.querySelectorAll('.preview-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      tabBtns.forEach(b => {
        b.classList.remove('active', 'text-white', 'bg-[#1E2330]', 'shadow-sm');
        b.classList.add('text-slate-400');
      });

      btn.classList.add('active', 'text-white', 'bg-[#1E2330]', 'shadow-sm');
      btn.classList.remove('text-slate-400');

      panels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });
</script>