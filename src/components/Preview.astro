---
import { LINKS } from '../config';
---

<section id="preview" class="py-20 md:py-28 border-b border-[#1E2633] bg-[#0B0E14]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[#0E121A] border border-[#1E2633] text-[#CCFF00] font-mono text-[11px] font-bold uppercase tracking-wider mb-4">
        <span>INTERFAZ OPERACIONAL • MOTOR SIGET</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white leading-tight font-sans">
        Así se ve el control total de tu torneo.
      </h2>
      <p class="text-base sm:text-lg text-slate-300 mt-4">
        Una consola sin distracciones. Rápida para el organizador en el portátil y optimizada para el árbitro al pie de la cancha sintética.
      </p>
    </div>

    <!-- Interactive Simulator Window -->
    <div class="max-w-5xl mx-auto">
      
      <!-- Tab Navigation -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <button 
          data-tab="tab-posiciones"
          class="preview-tab-btn active px-4 py-2 rounded-lg text-xs font-mono font-bold uppercase tracking-wider transition-colors border bg-[#CCFF00] text-black border-[#CCFF00]"
        >
          [ 01 • TABLA DE POSICIONES ]
        </button>
        <button 
          data-tab="tab-fixture"
          class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-mono font-bold uppercase tracking-wider transition-colors border bg-[#0E121A] text-slate-400 border-[#1E2633] hover:text-white hover:border-slate-600"
        >
          [ 02 • FIXTURE DEL DOMINGO ]
        </button>
        <button 
          data-tab="tab-disciplinario"
          class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-mono font-bold uppercase tracking-wider transition-colors border bg-[#0E121A] text-slate-400 border-[#1E2633] hover:text-white hover:border-slate-600"
        >
          [ 03 • CONTROL DISCIPLINARIO ]
        </button>
        <button 
          data-tab="tab-planilla"
          class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-mono font-bold uppercase tracking-wider transition-colors border bg-[#0E121A] text-slate-400 border-[#1E2633] hover:text-white hover:border-slate-600"
        >
          [ 04 • PLANILLA DIGITAL ]
        </button>
      </div>

      <!-- Main Display Box: High Contrast Tactical Matte Panel -->
      <div class="sport-card rounded-xl p-5 sm:p-7 border border-[#1E2633] bg-[#0E121A] shadow-2xl">
        
        <!-- Terminal Header -->
        <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#1E2633] font-mono text-xs">
          <div class="flex items-center gap-3 text-slate-400">
            <span class="w-2.5 h-2.5 bg-[#CCFF00]"></span>
            <span class="text-white font-bold">TORNEO ÉLITE CLAUSURA • CATEGORÍA LIBRE</span>
            <span class="text-slate-600 hidden sm:inline">|</span>
            <span class="text-slate-400 hidden sm:inline">SIGET V1 ENGINE</span>
          </div>
          <span class="text-[10px] text-[#CCFF00] bg-[#CCFF00]/10 border border-[#CCFF00]/30 px-2 py-0.5 rounded font-bold uppercase">
            SISTEMA EN LÍNEA
          </span>
        </div>

        <!-- TAB 1: Tabla de Posiciones Content -->
        <div id="tab-posiciones" class="preview-panel block">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
            <div>
              <h3 class="text-base font-bold text-white uppercase tracking-tight">Grupo A - Clasificación General</h3>
              <p class="text-xs text-slate-400 font-mono">Desempate: Puntos &gt; Gol Diferencia &gt; Goles a Favor</p>
            </div>
            <span class="text-xs font-mono text-slate-300 bg-[#141A24] px-3 py-1 rounded border border-[#1E2633]">
              8 Equipos en competencia
            </span>
          </div>

          <div class="overflow-x-auto rounded-lg border border-[#1E2633]">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-[#141A24] text-slate-400 uppercase font-mono text-[11px] tracking-wider border-b border-[#1E2633]">
                <tr>
                  <th class="py-2.5 px-3">POS</th>
                  <th class="py-2.5 px-3">EQUIPO</th>
                  <th class="py-2.5 px-2 text-center">PJ</th>
                  <th class="py-2.5 px-2 text-center">PG</th>
                  <th class="py-2.5 px-2 text-center">PE</th>
                  <th class="py-2.5 px-2 text-center">PP</th>
                  <th class="py-2.5 px-2 text-center">GF</th>
                  <th class="py-2.5 px-2 text-center">GC</th>
                  <th class="py-2.5 px-2 text-center font-bold text-slate-200">DG</th>
                  <th class="py-2.5 px-3 text-center font-bold text-[#CCFF00]">PTS</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#1E2633] font-mono text-xs">
                <tr class="bg-[#141A24]/40 hover:bg-[#141A24] transition-colors">
                  <td class="py-3 px-3 font-bold text-[#CCFF00]">01</td>
                  <td class="py-3 px-3 font-sans font-bold text-white flex items-center gap-2">
                    <span class="w-2 h-2 bg-[#CCFF00]"></span>
                    Atlético San Juan FC
                  </td>
                  <td class="py-3 px-2 text-center text-slate-300">7</td>
                  <td class="py-3 px-2 text-center text-slate-300">6</td>
                  <td class="py-3 px-2 text-center text-slate-300">0</td>
                  <td class="py-3 px-2 text-center text-slate-300">1</td>
                  <td class="py-3 px-2 text-center text-slate-300">18</td>
                  <td class="py-3 px-2 text-center text-slate-300">5</td>
                  <td class="py-3 px-2 text-center font-bold text-white">+13</td>
                  <td class="py-3 px-3 text-center font-bold text-black bg-[#CCFF00] text-sm">18</td>
                </tr>
                <tr class="bg-[#141A24]/40 hover:bg-[#141A24] transition-colors">
                  <td class="py-3 px-3 font-bold text-[#CCFF00]">02</td>
                  <td class="py-3 px-3 font-sans font-bold text-white flex items-center gap-2">
                    <span class="w-2 h-2 bg-[#CCFF00]"></span>
                    Deportivo Unión
                  </td>
                  <td class="py-3 px-2 text-center text-slate-300">7</td>
                  <td class="py-3 px-2 text-center text-slate-300">4</td>
                  <td class="py-3 px-2 text-center text-slate-300">2</td>
                  <td class="py-3 px-2 text-center text-slate-300">1</td>
                  <td class="py-3 px-2 text-center text-slate-300">14</td>
                  <td class="py-3 px-2 text-center text-slate-300">8</td>
                  <td class="py-3 px-2 text-center font-bold text-white">+6</td>
                  <td class="py-3 px-3 text-center font-bold text-black bg-[#CCFF00] text-sm">14</td>
                </tr>
                <tr class="hover:bg-[#141A24]/50 transition-colors">
                  <td class="py-3 px-3 font-bold text-slate-400">03</td>
                  <td class="py-3 px-3 font-sans font-medium text-slate-300">Leones del Norte</td>
                  <td class="py-3 px-2 text-center text-slate-400">7</td>
                  <td class="py-3 px-2 text-center text-slate-400">3</td>
                  <td class="py-3 px-2 text-center text-slate-400">2</td>
                  <td class="py-3 px-2 text-center text-slate-400">2</td>
                  <td class="py-3 px-2 text-center text-slate-400">11</td>
                  <td class="py-3 px-2 text-center text-slate-400">9</td>
                  <td class="py-3 px-2 text-center text-slate-300">+2</td>
                  <td class="py-3 px-3 text-center font-bold text-white text-sm bg-[#141A24]">11</td>
                </tr>
                <tr class="hover:bg-[#141A24]/50 transition-colors">
                  <td class="py-3 px-3 font-bold text-slate-400">04</td>
                  <td class="py-3 px-3 font-sans font-medium text-slate-300">Halcones Sintética</td>
                  <td class="py-3 px-2 text-center text-slate-400">7</td>
                  <td class="py-3 px-2 text-center text-slate-400">2</td>
                  <td class="py-3 px-2 text-center text-slate-400">1</td>
                  <td class="py-3 px-2 text-center text-slate-400">4</td>
                  <td class="py-3 px-2 text-center text-slate-400">9</td>
                  <td class="py-3 px-2 text-center text-slate-400">14</td>
                  <td class="py-3 px-2 text-center text-rose-400">-5</td>
                  <td class="py-3 px-3 text-center font-bold text-white text-sm bg-[#141A24]">07</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span class="flex items-center gap-1.5 text-[#CCFF00]">
              <span class="w-2 h-2 bg-[#CCFF00]"></span> Puestos 01 y 02 clasifican directo a semifinales
            </span>
            <span>Cálculo matemático certificado por SIGET</span>
          </div>
        </div>

        <!-- TAB 2: Fixture Content -->
        <div id="tab-fixture" class="preview-panel hidden">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-base font-bold text-white uppercase tracking-tight">Programación Domingo - Cancha Sintética</h3>
              <p class="text-xs text-slate-400 font-mono">Asignación automática de jueces y planilleros</p>
            </div>
            <span class="text-xs font-mono text-[#CCFF00] bg-[#CCFF00]/10 border border-[#CCFF00]/30 px-3 py-1 rounded">
              FECHA 8
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
            <div class="rounded-lg bg-[#080A0E] border border-[#1E2633] p-4">
              <div class="flex items-center justify-between text-slate-400 mb-2">
                <span>09:00 AM • CANCHA 1</span>
                <span class="text-[#CCFF00] font-bold">PROGRAMADO</span>
              </div>
              <div class="flex items-center justify-between py-2 border-y border-[#1E2633]">
                <span class="font-bold text-white font-sans text-sm">Atlético San Juan</span>
                <span class="text-slate-500 font-mono">VS</span>
                <span class="font-bold text-white font-sans text-sm">Halcones FC</span>
              </div>
              <div class="text-[11px] text-slate-400 mt-2 flex justify-between">
                <span>Juez Central: C. Rodríguez</span>
                <span class="text-[#CCFF00]">Planilla Lista</span>
              </div>
            </div>

            <div class="rounded-lg bg-[#080A0E] border border-[#1E2633] p-4">
              <div class="flex items-center justify-between text-slate-400 mb-2">
                <span>10:45 AM • CANCHA 1</span>
                <span class="text-[#CCFF00] font-bold">PROGRAMADO</span>
              </div>
              <div class="flex items-center justify-between py-2 border-y border-[#1E2633]">
                <span class="font-bold text-white font-sans text-sm">Deportivo Unión</span>
                <span class="text-slate-500 font-mono">VS</span>
                <span class="font-bold text-white font-sans text-sm">Leones del Norte</span>
              </div>
              <div class="text-[11px] text-slate-400 mt-2 flex justify-between">
                <span>Juez Central: M. Pardo</span>
                <span class="text-[#CCFF00]">Planilla Lista</span>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: Control Disciplinario Content -->
        <div id="tab-disciplinario" class="preview-panel hidden">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-base font-bold text-white uppercase tracking-tight">Resolución Disciplinaria Automática</h3>
              <p class="text-xs text-slate-400 font-mono">Inhabilitación inmediata al cerrar la planilla anterior</p>
            </div>
            <span class="text-xs font-mono text-rose-400 bg-rose-500/10 border border-rose-500/30 px-3 py-1 rounded">
              2 Sancionados
            </span>
          </div>

          <div class="space-y-3 font-mono text-xs">
            <div class="p-3.5 rounded-lg bg-[#141A24] border border-rose-500/40 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-lg">🟥</span>
                <div>
                  <h4 class="text-sm font-bold text-white font-sans">Carlos Valdés (Dorsal #10)</h4>
                  <p class="text-xs text-slate-400">Deportivo Unión • Expulsión directa (Roja directa)</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold text-rose-400 bg-rose-500/20 px-2 py-1 rounded">2 Fechas Pendientes</span>
                <p class="text-[10px] text-slate-400 mt-1">Cumple en Fechas 8 y 9</p>
              </div>
            </div>

            <div class="p-3.5 rounded-lg bg-[#141A24] border border-amber-500/40 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-lg">🟨</span>
                <div>
                  <h4 class="text-sm font-bold text-white font-sans">Javier Arango (Dorsal #5)</h4>
                  <p class="text-xs text-slate-400">Halcones Sintética • Acumulación de 3 Tarjetas Amarillas</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold text-amber-400 bg-amber-500/20 px-2 py-1 rounded">1 Fecha de Suspensión</span>
                <p class="text-[10px] text-slate-400 mt-1">Habilitado para Fecha 9</p>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 4: Planilla Digital Content -->
        <div id="tab-planilla" class="preview-panel hidden">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-base font-bold text-white uppercase tracking-tight">Acta Arbitral Digital en Pantalla</h3>
              <p class="text-xs text-slate-400 font-mono">Modo de registro rápido para el cuerpo técnico y arbitral</p>
            </div>
            <span class="text-xs font-mono text-[#CCFF00] bg-[#CCFF00]/10 border border-[#CCFF00]/30 px-3 py-1 rounded">
              ACTA ABIERTA
            </span>
          </div>

          <div class="rounded-lg bg-[#080A0E] border border-[#1E2633] p-4 grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono">
            <div class="p-3 bg-[#141A24] rounded border border-[#1E2633]">
              <span class="text-[10px] uppercase font-bold text-slate-400">Cronómetro del Partido</span>
              <div class="text-2xl font-bold text-[#CCFF00] mt-1 tabular-nums">78:42</div>
              <span class="text-[10px] text-slate-400">+3 Minutos adicionados</span>
            </div>
            <div class="p-3 bg-[#141A24] rounded border border-[#1E2633]">
              <span class="text-[10px] uppercase font-bold text-slate-400">Firmas de Capitanes</span>
              <div class="text-xs font-semibold text-white mt-2 flex items-center gap-1.5 font-sans">
                <span class="text-[#CCFF00]">✓</span> Cap. Local
                <span class="text-[#CCFF00] ml-2">✓</span> Cap. Visita
              </div>
              <span class="text-[10px] text-slate-400 mt-1 block">Validado con PIN</span>
            </div>
            <div class="p-3 bg-[#141A24] rounded border border-[#1E2633]">
              <span class="text-[10px] uppercase font-bold text-slate-400">Cierre Oficial</span>
              <div class="text-xs font-bold text-[#CCFF00] mt-2 font-sans">Descargar PDF Certificado</div>
              <span class="text-[10px] text-slate-400 mt-1 block">Generado en 1 clic</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Live Demo CTA -->
      <div class="mt-8 text-center">
        <a 
          href={LINKS.whatsappContact} 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-slate-300 hover:text-[#CCFF00] transition-colors"
        >
          <span>[ Probar la consola de SIGET con los datos de tu torneo -&gt; Hablar por WhatsApp ]</span>
        </a>
      </div>

    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.preview-tab-btn');
  const panels = document.querySelectorAll('.preview-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      tabBtns.forEach(b => {
        b.classList.remove('bg-[#CCFF00]', 'text-black', 'border-[#CCFF00]');
        b.classList.add('bg-[#0E121A]', 'text-slate-400', 'border-[#1E2633]');
      });

      btn.classList.add('bg-[#CCFF00]', 'text-black', 'border-[#CCFF00]');
      btn.classList.remove('bg-[#0E121A]', 'text-slate-400', 'border-[#1E2633]');

      panels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });
</script>