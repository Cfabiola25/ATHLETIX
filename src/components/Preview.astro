---
import { LINKS } from '../config';
---

<section id="preview" class="py-20 md:py-32 relative overflow-hidden bg-slate-950/60 border-y border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-950/50 border border-cyan-500/30 px-3 py-1 rounded-full">
        Visualiza el Poder de SIGET
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mt-4 mb-4">
        Una interfaz rápida, limpia y <span class="text-gradient-emerald">diseñada para el terreno</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        Diseñada para que el organizador trabaje cómodo desde el computador y el árbitro califique desde su teléfono celular al borde de la cancha.
      </p>
    </div>

    <!-- Interactive Simulator Window -->
    <div class="max-w-5xl mx-auto">
      
      <!-- Tab Navigation -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
        <button 
          data-tab="tab-posiciones"
          class="preview-tab-btn active px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 border bg-emerald-500/20 text-emerald-400 border-emerald-500/40 shadow-sm"
        >
          📊 Tabla de Posiciones
        </button>
        <button 
          data-tab="tab-fixture"
          class="preview-tab-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 border bg-slate-900/80 text-slate-400 border-slate-800 hover:text-white hover:border-slate-700"
        >
          ⚔️ Fixture y Cruces de Llaves
        </button>
        <button 
          data-tab="tab-disciplinario"
          class="preview-tab-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 border bg-slate-900/80 text-slate-400 border-slate-800 hover:text-white hover:border-slate-700"
        >
          🟨 Control Disciplinario
        </button>
        <button 
          data-tab="tab-planilla"
          class="preview-tab-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 border bg-slate-900/80 text-slate-400 border-slate-800 hover:text-white hover:border-slate-700"
        >
          📱 Planilla Arbitral Móvil
        </button>
      </div>

      <!-- Main Display Box -->
      <div class="glass-panel rounded-2xl p-4 sm:p-7 shadow-2xl border border-slate-700/80 relative">
        
        <!-- Top Browser Simulation Bar -->
        <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-800">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            <span class="ml-3 text-xs font-mono text-slate-400 hidden sm:inline">https://app.athletix.com/admin/torneos/copa-verano</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded font-mono">
              ● Servidor Conectado
            </span>
          </div>
        </div>

        <!-- TAB 1: Tabla de Posiciones Content -->
        <div id="tab-posiciones" class="preview-panel block">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
            <div>
              <h3 class="text-lg font-bold text-white">Torneo Nocturno Categoría Libre - Grupo A</h3>
              <p class="text-xs text-slate-400">Puntaje actualizado con criterio de desempate por Gol Diferencia y Goles a Favor</p>
            </div>
            <span class="text-xs font-semibold bg-slate-800 text-slate-300 px-3 py-1 rounded-lg border border-slate-700">
              8 Equipos Registrados
            </span>
          </div>

          <div class="overflow-x-auto rounded-xl border border-slate-800">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-slate-900/90 text-slate-400 uppercase font-semibold text-[11px] tracking-wider border-b border-slate-800">
                <tr>
                  <th class="py-3 px-3">Pos</th>
                  <th class="py-3 px-3">Equipo</th>
                  <th class="py-3 px-2 text-center">PJ</th>
                  <th class="py-3 px-2 text-center">PG</th>
                  <th class="py-3 px-2 text-center">PE</th>
                  <th class="py-3 px-2 text-center">PP</th>
                  <th class="py-3 px-2 text-center">GF</th>
                  <th class="py-3 px-2 text-center">GC</th>
                  <th class="py-3 px-2 text-center font-bold text-cyan-400">DG</th>
                  <th class="py-3 px-3 text-center font-bold text-emerald-400">PTS</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
                <tr class="bg-emerald-500/5 hover:bg-emerald-500/10 transition-colors">
                  <td class="py-3 px-3 font-sans font-bold text-emerald-400">
                    <span class="w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center">1</span>
                  </td>
                  <td class="py-3 px-3 font-sans font-bold text-white flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                    Atlético San Juan FC
                  </td>
                  <td class="py-3 px-2 text-center text-slate-300">7</td>
                  <td class="py-3 px-2 text-center text-slate-300">6</td>
                  <td class="py-3 px-2 text-center text-slate-300">0</td>
                  <td class="py-3 px-2 text-center text-slate-300">1</td>
                  <td class="py-3 px-2 text-center text-slate-300">18</td>
                  <td class="py-3 px-2 text-center text-slate-300">5</td>
                  <td class="py-3 px-2 text-center font-bold text-cyan-400">+13</td>
                  <td class="py-3 px-3 text-center font-bold text-emerald-400 bg-emerald-500/20 text-sm">18</td>
                </tr>
                <tr class="bg-emerald-500/5 hover:bg-emerald-500/10 transition-colors">
                  <td class="py-3 px-3 font-sans font-bold text-emerald-400">
                    <span class="w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center">2</span>
                  </td>
                  <td class="py-3 px-3 font-sans font-bold text-white flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                    Deportivo Unión
                  </td>
                  <td class="py-3 px-2 text-center text-slate-300">7</td>
                  <td class="py-3 px-2 text-center text-slate-300">4</td>
                  <td class="py-3 px-2 text-center text-slate-300">2</td>
                  <td class="py-3 px-2 text-center text-slate-300">1</td>
                  <td class="py-3 px-2 text-center text-slate-300">14</td>
                  <td class="py-3 px-2 text-center text-slate-300">8</td>
                  <td class="py-3 px-2 text-center font-bold text-cyan-400">+6</td>
                  <td class="py-3 px-3 text-center font-bold text-emerald-400 bg-emerald-500/20 text-sm">14</td>
                </tr>
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="py-3 px-3 font-sans font-medium text-slate-400">3</td>
                  <td class="py-3 px-3 font-sans font-medium text-slate-300">Leones del Norte</td>
                  <td class="py-3 px-2 text-center text-slate-400">7</td>
                  <td class="py-3 px-2 text-center text-slate-400">3</td>
                  <td class="py-3 px-2 text-center text-slate-400">2</td>
                  <td class="py-3 px-2 text-center text-slate-400">2</td>
                  <td class="py-3 px-2 text-center text-slate-400">11</td>
                  <td class="py-3 px-2 text-center text-slate-400">9</td>
                  <td class="py-3 px-2 text-center font-medium text-cyan-400">+2</td>
                  <td class="py-3 px-3 text-center font-bold text-slate-200 text-sm">11</td>
                </tr>
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="py-3 px-3 font-sans font-medium text-slate-400">4</td>
                  <td class="py-3 px-3 font-sans font-medium text-slate-300">Halcones Sintética</td>
                  <td class="py-3 px-2 text-center text-slate-400">7</td>
                  <td class="py-3 px-2 text-center text-slate-400">2</td>
                  <td class="py-3 px-2 text-center text-slate-400">1</td>
                  <td class="py-3 px-2 text-center text-slate-400">4</td>
                  <td class="py-3 px-2 text-center text-slate-400">9</td>
                  <td class="py-3 px-2 text-center text-slate-400">14</td>
                  <td class="py-3 px-2 text-center font-medium text-rose-400">-5</td>
                  <td class="py-3 px-3 text-center font-bold text-slate-200 text-sm">7</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Zona de clasificación a Semifinales
            </span>
            <span>Cálculo automático garantizado por SIGET</span>
          </div>
        </div>

        <!-- TAB 2: Fixture Content -->
        <div id="tab-fixture" class="preview-panel hidden">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-lg font-bold text-white">Programación de Partidos - Jornada 8</h3>
              <p class="text-xs text-slate-400">Horarios sin cruces de árbitros ni duplicidad de canchas</p>
            </div>
            <span class="text-xs bg-cyan-500/20 text-cyan-400 px-3 py-1 rounded border border-cyan-500/30">
              Cancha Sintética Central
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="rounded-xl bg-slate-900 border border-slate-800 p-4">
              <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                <span>Viernes 7:00 PM • Cancha 1</span>
                <span class="text-emerald-400 font-bold">Por Jugar</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="font-bold text-white text-sm">Atlético San Juan</span>
                <span class="text-xs font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-300">VS</span>
                <span class="font-bold text-white text-sm">Halcones Sintética</span>
              </div>
              <div class="text-[11px] text-slate-400 mt-2 border-t border-slate-800/80 pt-2 flex justify-between">
                <span>Árbitro: C. Rodríguez</span>
                <span class="text-emerald-400">Planilla habilitada</span>
              </div>
            </div>

            <div class="rounded-xl bg-slate-900 border border-slate-800 p-4">
              <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                <span>Viernes 8:30 PM • Cancha 1</span>
                <span class="text-emerald-400 font-bold">Por Jugar</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="font-bold text-white text-sm">Deportivo Unión</span>
                <span class="text-xs font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-300">VS</span>
                <span class="font-bold text-white text-sm">Leones del Norte</span>
              </div>
              <div class="text-[11px] text-slate-400 mt-2 border-t border-slate-800/80 pt-2 flex justify-between">
                <span>Árbitro: M. Pardo</span>
                <span class="text-emerald-400">Planilla habilitada</span>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: Control Disciplinario Content -->
        <div id="tab-disciplinario" class="preview-panel hidden">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-lg font-bold text-white">Sanciones Disciplinarias y Reporte Fair Play</h3>
              <p class="text-xs text-slate-400">Validación automática antes de cada juego</p>
            </div>
            <span class="text-xs bg-rose-500/20 text-rose-400 px-3 py-1 rounded border border-rose-500/30">
              2 Jugadores Inhabilitados
            </span>
          </div>

          <div class="space-y-3">
            <div class="p-3.5 rounded-xl bg-rose-950/20 border border-rose-500/30 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-sm">
                  🟥
                </div>
                <div>
                  <h4 class="text-sm font-bold text-white">Carlos Valdés (Dorsal #10)</h4>
                  <p class="text-xs text-slate-400">Deportivo Unión • Expulsión directa (Conducta antideportiva)</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold text-rose-400 bg-rose-500/20 px-2 py-1 rounded">2 Fechas Pendientes</span>
                <p class="text-[10px] text-slate-400 mt-1">Cumple en Fechas 8 y 9</p>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-amber-950/20 border border-amber-500/30 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm">
                  🟨
                </div>
                <div>
                  <h4 class="text-sm font-bold text-white">Javier Arango (Dorsal #5)</h4>
                  <p class="text-xs text-slate-400">Halcones Sintética • Acumulación de 3 Tarjetas Amarillas</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold text-amber-400 bg-amber-500/20 px-2 py-1 rounded">1 Fecha de Suspensión</span>
                <p class="text-[10px] text-slate-400 mt-1">Habilitado para Fecha 9</p>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 4: Planilla Digital Content -->
        <div id="tab-planilla" class="preview-panel hidden">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-lg font-bold text-white">Planilla Arbitral Digital 100% Responsiva</h3>
              <p class="text-xs text-slate-400">Acceso móvil para jueces, cronometristas y planilleros</p>
            </div>
            <span class="text-xs bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded border border-emerald-500/30">
              Modo Árbitro Activo
            </span>
          </div>

          <div class="rounded-xl bg-slate-900 border border-slate-800 p-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-3 bg-slate-950 rounded-lg border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-400">Tiempo de Juego</span>
              <div class="text-2xl font-mono font-bold text-emerald-400 mt-1">78:24</div>
              <span class="text-[10px] text-slate-400">+3' Adición calculada</span>
            </div>
            <div class="p-3 bg-slate-950 rounded-lg border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-400">Firmas Digitales</span>
              <div class="text-xs font-semibold text-white mt-2 flex items-center gap-1.5">
                <span class="text-emerald-400">✓</span> Capitán Local
                <span class="text-emerald-400 ml-2">✓</span> Capitán Visita
              </div>
              <span class="text-[10px] text-slate-400 mt-1 block">Validado con código PIN</span>
            </div>
            <div class="p-3 bg-slate-950 rounded-lg border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-400">Cierre de Acta</span>
              <div class="text-xs font-semibold text-cyan-400 mt-2">Exportar PDF Oficial</div>
              <span class="text-[10px] text-slate-400 mt-1 block">Envío automático a delegados</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Live Demo CTA -->
      <div class="mt-8 text-center">
        <a 
          href={LINKS.whatsappDemo} 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-bold text-emerald-400 hover:text-emerald-300 transition-colors"
        >
          <span>¿Quieres probar esta vista en vivo con los datos de tu torneo? Agenda una demo aquí</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.preview-tab-btn');
  const panels = document.querySelectorAll('.preview-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      // Update button styles
      tabBtns.forEach(b => {
        b.classList.remove('bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40', 'shadow-sm');
        b.classList.add('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
      });

      btn.classList.add('bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40', 'shadow-sm');
      btn.classList.remove('bg-slate-900/80', 'text-slate-400', 'border-slate-800');

      // Show targeted panel
      panels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });
</script>