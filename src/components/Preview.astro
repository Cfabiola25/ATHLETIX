---
import { LINKS } from '../config';
---

<section id="preview" class="py-24 md:py-32 border-t border-blue-500/15 relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-400 bg-blue-950/60 border border-blue-500/30 px-3 py-1 rounded-full mb-4 inline-block">
        Demostración de la plataforma
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
        Una experiencia fluida, pensada como una aplicación nativa.
      </h2>
      <p class="text-base text-slate-300 mt-4 leading-relaxed">
        Tablas sin sobrecarga visual, lectura inmediata de marcadores y acceso instantáneo para el organizador y el cuerpo arbitral.
      </p>
    </div>

    <!-- Segmented Control Bar -->
    <div class="flex items-center gap-1.5 bg-[#161B26] p-1.5 rounded-2xl border border-blue-500/25 w-fit mb-8 max-w-full overflow-x-auto shadow-lg shadow-black/30">
      <button 
        data-tab="tab-posiciones"
        class="preview-tab-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all text-[#0D1117] bg-white shadow-md whitespace-nowrap"
      >
        Tabla de posiciones
      </button>
      <button 
        data-tab="tab-fixture"
        class="preview-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:text-white whitespace-nowrap"
      >
        Programación y fixture
      </button>
      <button 
        data-tab="tab-disciplinario"
        class="preview-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:text-white whitespace-nowrap"
      >
        Control disciplinario
      </button>
      <button 
        data-tab="tab-planilla"
        class="preview-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:text-white whitespace-nowrap"
      >
        Planilla digital
      </button>
    </div>

    <!-- Main Container Card -->
    <div class="card-vivid rounded-2xl p-6 sm:p-8 shadow-2xl">
      
      <!-- TAB 1: Tabla de posiciones -->
      <div id="tab-posiciones" class="preview-panel block">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-blue-500/15 gap-3">
          <div>
            <h3 class="text-base font-bold text-white">Torneo Clausura — Categoría Libre</h3>
            <p class="text-xs text-blue-300/80 mt-0.5">Grupo A · Criterio de desempate federativo</p>
          </div>
          <span class="text-xs font-semibold text-blue-200 bg-blue-950/60 px-3 py-1 rounded-full border border-blue-500/30 w-fit">
            8 equipos participantes
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="text-[12px] font-bold text-slate-300 border-b border-blue-500/20 uppercase tracking-wider">
                <th class="pb-3 px-3 w-12 font-semibold">Pos</th>
                <th class="pb-3 px-3 font-semibold">Club</th>
                <th class="pb-3 px-2 text-center font-semibold">PJ</th>
                <th class="pb-3 px-2 text-center font-semibold">PG</th>
                <th class="pb-3 px-2 text-center font-semibold">PE</th>
                <th class="pb-3 px-2 text-center font-semibold">PP</th>
                <th class="pb-3 px-2 text-center font-semibold">GF</th>
                <th class="pb-3 px-2 text-center font-semibold">GC</th>
                <th class="pb-3 px-2 text-center font-semibold text-blue-300">DG</th>
                <th class="pb-3 px-4 text-center font-bold text-white">PTS</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-blue-500/10">
              
              <!-- Row 1 -->
              <tr class="group hover:bg-white/[0.03] transition-colors bg-blue-950/20">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-blue-600/40 text-blue-200 flex items-center justify-center font-bold text-xs border border-blue-400/40 shadow-xs">
                    1
                  </span>
                </td>
                <td class="py-3.5 px-3 font-bold text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-blue-600 flex items-center justify-center text-[10px] font-bold text-white shadow-xs">
                      AS
                    </span>
                    <span>Atlético San Juan</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">7</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">6</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">0</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono">18</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">5</td>
                <td class="py-3.5 px-2 text-center font-bold text-blue-400 tabular-nums font-mono">+13</td>
                <td class="py-3.5 px-4 text-center font-extrabold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-blue-600/30 border border-blue-400/40 text-white">18</span>
                </td>
              </tr>

              <!-- Row 2 -->
              <tr class="group hover:bg-white/[0.03] transition-colors bg-blue-950/20">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-blue-600/40 text-blue-200 flex items-center justify-center font-bold text-xs border border-blue-400/40 shadow-xs">
                    2
                  </span>
                </td>
                <td class="py-3.5 px-3 font-bold text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-indigo-600 flex items-center justify-center text-[10px] font-bold text-white shadow-xs">
                      DU
                    </span>
                    <span>Deportivo Unión</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">7</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono font-medium">4</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-slate-200 tabular-nums font-mono">14</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">8</td>
                <td class="py-3.5 px-2 text-center font-bold text-blue-400 tabular-nums font-mono">+6</td>
                <td class="py-3.5 px-4 text-center font-extrabold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-blue-600/30 border border-blue-400/40 text-white">14</span>
                </td>
              </tr>

              <!-- Row 3 -->
              <tr class="group hover:bg-white/[0.03] transition-colors">
                <td class="py-3.5 px-3 text-slate-400 font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">3</span>
                </td>
                <td class="py-3.5 px-3 font-semibold text-slate-200">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-slate-700 flex items-center justify-center text-[10px] font-bold text-slate-300">
                      LN
                    </span>
                    <span>Leones del Norte</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">3</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">11</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">9</td>
                <td class="py-3.5 px-2 text-center font-medium text-slate-300 tabular-nums font-mono">+2</td>
                <td class="py-3.5 px-4 text-center font-bold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-white/[0.05]">11</span>
                </td>
              </tr>

              <!-- Row 4 -->
              <tr class="group hover:bg-white/[0.03] transition-colors">
                <td class="py-3.5 px-3 text-slate-400 font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">4</span>
                </td>
                <td class="py-3.5 px-3 font-semibold text-slate-200">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-slate-700 flex items-center justify-center text-[10px] font-bold text-slate-300">
                      HF
                    </span>
                    <span>Halcones Sintética</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">4</td>
                <td class="py-3.5 px-2 text-center text-slate-300 tabular-nums font-mono">9</td>
                <td class="py-3.5 px-2 text-center text-slate-400 tabular-nums font-mono">14</td>
                <td class="py-3.5 px-2 text-center font-medium text-rose-400 tabular-nums font-mono">-5</td>
                <td class="py-3.5 px-4 text-center font-bold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-white/[0.05]">07</span>
                </td>
              </tr>

            </tbody>
          </table>
        </div>

        <div class="mt-5 pt-4 border-t border-blue-500/15 flex items-center justify-between text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shadow-xs shadow-blue-500/80"></span>
            <span class="font-medium text-white">Clasificación directa a semifinales</span>
          </div>
          <span class="text-blue-300">Actualización en tiempo real vía SIGET</span>
        </div>
      </div>

      <!-- TAB 2: Programación / Fixture -->
      <div id="tab-fixture" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-blue-500/15">
          <div>
            <h3 class="text-base font-bold text-white">Programación — Próximo domingo</h3>
            <p class="text-xs text-blue-300/80 mt-0.5">Asignación automática de canchas y jueces</p>
          </div>
          <span class="text-xs font-semibold text-blue-200 bg-blue-950/60 px-3 py-1 rounded-full border border-blue-500/30">
            Jornada 8
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-[#0D1117] border border-blue-500/20">
            <div class="flex items-center justify-between text-xs text-slate-300 mb-3">
              <span class="font-bold text-white">09:00 AM · Cancha Central</span>
              <span class="text-blue-400 font-semibold bg-blue-950/60 px-2 py-0.5 rounded border border-blue-500/30">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-bold text-white text-sm">
              <span>Atlético San Juan</span>
              <span class="text-blue-400 text-xs">vs</span>
              <span>Halcones Sintética</span>
            </div>
            <div class="mt-3 pt-3 border-t border-blue-500/15 flex items-center justify-between text-xs text-slate-300">
              <span>Juez: Carlos Rodríguez</span>
              <span class="text-blue-400 font-medium">Planilla lista</span>
            </div>
          </div>

          <div class="p-5 rounded-xl bg-[#0D1117] border border-blue-500/20">
            <div class="flex items-center justify-between text-xs text-slate-300 mb-3">
              <span class="font-bold text-white">10:45 AM · Cancha Central</span>
              <span class="text-blue-400 font-semibold bg-blue-950/60 px-2 py-0.5 rounded border border-blue-500/30">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-bold text-white text-sm">
              <span>Deportivo Unión</span>
              <span class="text-blue-400 text-xs">vs</span>
              <span>Leones del Norte</span>
            </div>
            <div class="mt-3 pt-3 border-t border-blue-500/15 flex items-center justify-between text-xs text-slate-300">
              <span>Juez: Mario Pardo</span>
              <span class="text-blue-400 font-medium">Planilla lista</span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: Control Disciplinario -->
      <div id="tab-disciplinario" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-blue-500/15">
          <div>
            <h3 class="text-base font-bold text-white">Sanciones y tarjetas</h3>
            <p class="text-xs text-blue-300/80 mt-0.5">Inhabilitación automática para la siguiente fecha</p>
          </div>
          <span class="text-xs font-semibold text-rose-300 bg-rose-950/60 px-3 py-1 rounded-full border border-rose-500/40">
            2 inhabilitaciones vigentes
          </span>
        </div>

        <div class="space-y-3">
          <div class="p-4 rounded-xl bg-[#0D1117] border border-blue-500/20 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-rose-500/25 border border-rose-500/40 text-rose-300 flex items-center justify-center text-sm font-bold shadow-xs">
                R
              </span>
              <div>
                <h4 class="text-sm font-bold text-white">Carlos Valdés (#10)</h4>
                <p class="text-xs text-slate-300">Deportivo Unión · Expulsión directa</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold text-rose-300 bg-rose-950/70 px-2.5 py-1 rounded-full border border-rose-500/40">
                2 fechas pendientes
              </span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#0D1117] border border-blue-500/20 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-amber-500/25 border border-amber-500/40 text-amber-300 flex items-center justify-center text-sm font-bold shadow-xs">
                A
              </span>
              <div>
                <h4 class="text-sm font-bold text-white">Javier Arango (#5)</h4>
                <p class="text-xs text-slate-300">Halcones Sintética · Acumulación de 3 tarjetas amarillas</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold text-amber-300 bg-amber-950/70 px-2.5 py-1 rounded-full border border-amber-500/40">
                1 fecha de suspensión
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 4: Planilla digital -->
      <div id="tab-planilla" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-blue-500/15">
          <div>
            <h3 class="text-base font-bold text-white">Planilla arbitral móvil</h3>
            <p class="text-xs text-blue-300/80 mt-0.5">Diseñada para captura rápida desde el celular del árbitro</p>
          </div>
          <span class="text-xs font-semibold text-blue-200 bg-blue-950/60 px-3 py-1 rounded-full border border-blue-500/30">
            Acta abierta
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-xl bg-[#0D1117] border border-blue-500/20">
            <span class="text-xs text-slate-300 block mb-1">Tiempo de juego</span>
            <div class="text-2xl font-black text-white tabular-nums font-mono">78:42</div>
            <span class="text-xs text-blue-400 font-semibold mt-1 block">+3' tiempo de adición</span>
          </div>

          <div class="p-5 rounded-xl bg-[#0D1117] border border-blue-500/20">
            <span class="text-xs text-slate-300 block mb-1">Firmas de capitanes</span>
            <div class="text-sm font-bold text-white mt-2 flex items-center gap-2">
              <span class="text-blue-400 font-bold">✓</span> Local
              <span class="text-blue-400 font-bold ml-2">✓</span> Visitante
            </div>
            <span class="text-xs text-slate-400 mt-1 block">Validado con código de seguridad</span>
          </div>

          <div class="p-5 rounded-xl bg-[#0D1117] border border-blue-500/20">
            <span class="text-xs text-slate-300 block mb-1">Cierre de encuentro</span>
            <div class="text-sm font-bold text-blue-300 mt-2">Exportar boletín oficial</div>
            <span class="text-xs text-slate-400 mt-1 block">Generación automática en PDF</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.preview-tab-btn');
  const panels = document.querySelectorAll('.preview-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      tabBtns.forEach(b => {
        b.classList.remove('active', 'text-[#0D1117]', 'bg-white', 'shadow-md');
        b.classList.add('text-slate-300');
      });

      btn.classList.add('active', 'text-[#0D1117]', 'bg-white', 'shadow-md');
      btn.classList.remove('text-slate-300');

      panels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });
</script>