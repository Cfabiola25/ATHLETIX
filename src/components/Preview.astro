---
import { LINKS } from '../config';
---

<section id="preview" class="py-24 md:py-32 bg-[#1F1F20] border-t border-[#606D80]/20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#567EBB] mb-3 block">
        Demostración de la plataforma
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
        Una experiencia fluida, pensada como una aplicación nativa.
      </h2>
      <p class="text-base text-[#A0ABB8] mt-4 leading-relaxed">
        Tablas sin sobrecarga visual, lectura inmediata de marcadores y acceso instantáneo para el organizador y el cuerpo arbitral.
      </p>
    </div>

    <!-- Segmented Control Bar -->
    <div class="flex items-center gap-1 bg-[#26272A] p-1 rounded-xl border border-[#606D80]/30 w-fit mb-8 max-w-full overflow-x-auto shadow-md">
      <button 
        data-tab="tab-posiciones"
        class="preview-tab-btn active px-4 py-2 rounded-lg text-xs font-semibold transition-all text-[#1F1F20] bg-white shadow-sm whitespace-nowrap"
      >
        Tabla de posiciones
      </button>
      <button 
        data-tab="tab-fixture"
        class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-medium transition-all text-[#A0ABB8] hover:text-white whitespace-nowrap"
      >
        Programación y fixture
      </button>
      <button 
        data-tab="tab-disciplinario"
        class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-medium transition-all text-[#A0ABB8] hover:text-white whitespace-nowrap"
      >
        Control disciplinario
      </button>
      <button 
        data-tab="tab-planilla"
        class="preview-tab-btn px-4 py-2 rounded-lg text-xs font-medium transition-all text-[#A0ABB8] hover:text-white whitespace-nowrap"
      >
        Planilla digital
      </button>
    </div>

    <!-- Main Container Card -->
    <div class="bg-[#26272A] rounded-2xl p-6 sm:p-8 border border-[#606D80]/25 shadow-2xl shadow-black/30">
      
      <!-- TAB 1: Tabla de posiciones -->
      <div id="tab-posiciones" class="preview-panel block">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-[#606D80]/20 gap-3">
          <div>
            <h3 class="text-base font-semibold text-white">Torneo Clausura — Categoría Libre</h3>
            <p class="text-xs text-[#A0ABB8] mt-0.5">Grupo A · Criterio de desempate federativo</p>
          </div>
          <span class="text-xs font-medium text-[#DCE0E6] bg-white/[0.04] px-3 py-1 rounded-full border border-[#606D80]/30 w-fit">
            8 equipos participantes
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="text-[12px] font-medium text-[#A0ABB8] border-b border-[#606D80]/20">
                <th class="pb-3 px-3 w-12 font-normal">Pos</th>
                <th class="pb-3 px-3 font-normal">Club</th>
                <th class="pb-3 px-2 text-center font-normal">PJ</th>
                <th class="pb-3 px-2 text-center font-normal">PG</th>
                <th class="pb-3 px-2 text-center font-normal">PE</th>
                <th class="pb-3 px-2 text-center font-normal">PP</th>
                <th class="pb-3 px-2 text-center font-normal">GF</th>
                <th class="pb-3 px-2 text-center font-normal">GC</th>
                <th class="pb-3 px-2 text-center font-normal">DG</th>
                <th class="pb-3 px-4 text-center font-medium text-white">PTS</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#606D80]/15">
              
              <!-- Row 1 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-[#2B4C7E]/50 text-[#DCE0E6] flex items-center justify-center font-bold text-xs border border-[#567EBB]/30">
                    1
                  </span>
                </td>
                <td class="py-3.5 px-3 font-medium text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#2B4C7E] flex items-center justify-center text-[10px] font-bold text-white">
                      AS
                    </span>
                    <span>Atlético San Juan</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-[#DCE0E6] tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-[#DCE0E6] tabular-nums font-mono">6</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">0</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-[#DCE0E6] tabular-nums font-mono">18</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">5</td>
                <td class="py-3.5 px-2 text-center font-bold text-[#567EBB] tabular-nums font-mono">+13</td>
                <td class="py-3.5 px-4 text-center font-bold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-white/[0.08] text-[#DCE0E6]">18</span>
                </td>
              </tr>

              <!-- Row 2 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3">
                  <span class="w-6 h-6 rounded-full bg-[#2B4C7E]/50 text-[#DCE0E6] flex items-center justify-center font-bold text-xs border border-[#567EBB]/30">
                    2
                  </span>
                </td>
                <td class="py-3.5 px-3 font-medium text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#2B4C7E] flex items-center justify-center text-[10px] font-bold text-white">
                      DU
                    </span>
                    <span>Deportivo Unión</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-[#DCE0E6] tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-[#DCE0E6] tabular-nums font-mono">4</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-[#DCE0E6] tabular-nums font-mono">14</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">8</td>
                <td class="py-3.5 px-2 text-center font-bold text-[#567EBB] tabular-nums font-mono">+6</td>
                <td class="py-3.5 px-4 text-center font-bold text-white tabular-nums font-mono">
                  <span class="px-2.5 py-1 rounded-md bg-white/[0.08] text-[#DCE0E6]">14</span>
                </td>
              </tr>

              <!-- Row 3 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3 text-[#A0ABB8] font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">3</span>
                </td>
                <td class="py-3.5 px-3 font-medium text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#606D80]/30 flex items-center justify-center text-[10px] font-bold text-[#A0ABB8]">
                      LN
                    </span>
                    <span>Leones del Norte</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">3</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">11</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">9</td>
                <td class="py-3.5 px-2 text-center font-medium text-[#A0ABB8] tabular-nums font-mono">+2</td>
                <td class="py-3.5 px-4 text-center font-medium text-[#DCE0E6] tabular-nums font-mono">
                  <span class="px-2 py-0.5 rounded-md bg-white/[0.04]">11</span>
                </td>
              </tr>

              <!-- Row 4 -->
              <tr class="group hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-3 text-[#A0ABB8] font-medium">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs">4</span>
                </td>
                <td class="py-3.5 px-3 font-medium text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-md bg-[#606D80]/30 flex items-center justify-center text-[10px] font-bold text-[#A0ABB8]">
                      HF
                    </span>
                    <span>Halcones Sintética</span>
                  </div>
                </td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">7</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">2</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">1</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">4</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">9</td>
                <td class="py-3.5 px-2 text-center text-[#A0ABB8] tabular-nums font-mono">14</td>
                <td class="py-3.5 px-2 text-center font-medium text-rose-400 tabular-nums font-mono">-5</td>
                <td class="py-3.5 px-4 text-center font-medium text-[#DCE0E6] tabular-nums font-mono">
                  <span class="px-2 py-0.5 rounded-md bg-white/[0.04]">07</span>
                </td>
              </tr>

            </tbody>
          </table>
        </div>

        <div class="mt-5 pt-4 border-t border-[#606D80]/20 flex items-center justify-between text-xs text-[#A0ABB8]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#567EBB]"></span>
            <span>Clasificación directa a semifinales</span>
          </div>
          <span>Actualización en tiempo real vía SIGET</span>
        </div>
      </div>

      <!-- TAB 2: Programación / Fixture -->
      <div id="tab-fixture" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-[#606D80]/20">
          <div>
            <h3 class="text-base font-semibold text-white">Programación — Próximo domingo</h3>
            <p class="text-xs text-[#A0ABB8] mt-0.5">Asignación automática de canchas y jueces</p>
          </div>
          <span class="text-xs font-medium text-[#DCE0E6] bg-white/[0.04] px-3 py-1 rounded-full border border-[#606D80]/30">
            Jornada 8
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-[#1F1F20] border border-[#606D80]/25">
            <div class="flex items-center justify-between text-xs text-[#A0ABB8] mb-3">
              <span>09:00 AM · Cancha Central</span>
              <span class="text-[#567EBB] font-medium">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-medium text-white text-sm">
              <span>Atlético San Juan</span>
              <span class="text-[#606D80] text-xs">vs</span>
              <span>Halcones Sintética</span>
            </div>
            <div class="mt-3 pt-3 border-t border-[#606D80]/20 flex items-center justify-between text-xs text-[#A0ABB8]">
              <span>Juez: Carlos Rodríguez</span>
              <span class="text-[#567EBB]">Planilla lista</span>
            </div>
          </div>

          <div class="p-5 rounded-xl bg-[#1F1F20] border border-[#606D80]/25">
            <div class="flex items-center justify-between text-xs text-[#A0ABB8] mb-3">
              <span>10:45 AM · Cancha Central</span>
              <span class="text-[#567EBB] font-medium">Programado</span>
            </div>
            <div class="flex items-center justify-between py-2 font-medium text-white text-sm">
              <span>Deportivo Unión</span>
              <span class="text-[#606D80] text-xs">vs</span>
              <span>Leones del Norte</span>
            </div>
            <div class="mt-3 pt-3 border-t border-[#606D80]/20 flex items-center justify-between text-xs text-[#A0ABB8]">
              <span>Juez: Mario Pardo</span>
              <span class="text-[#567EBB]">Planilla lista</span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: Control Disciplinario -->
      <div id="tab-disciplinario" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-[#606D80]/20">
          <div>
            <h3 class="text-base font-semibold text-white">Sanciones y tarjetas</h3>
            <p class="text-xs text-[#A0ABB8] mt-0.5">Inhabilitación automática para la siguiente fecha</p>
          </div>
          <span class="text-xs font-medium text-rose-300 bg-rose-500/20 px-3 py-1 rounded-full border border-rose-500/30">
            2 inhabilitaciones vigentes
          </span>
        </div>

        <div class="space-y-3">
          <div class="p-4 rounded-xl bg-[#1F1F20] border border-[#606D80]/25 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-300 flex items-center justify-center text-sm font-semibold">
                R
              </span>
              <div>
                <h4 class="text-sm font-medium text-white">Carlos Valdés (#10)</h4>
                <p class="text-xs text-[#A0ABB8]">Deportivo Unión · Expulsión directa</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-medium text-rose-300 bg-rose-500/20 px-2.5 py-1 rounded-full border border-rose-500/30">
                2 fechas pendientes
              </span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#1F1F20] border border-[#606D80]/25 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-300 flex items-center justify-center text-sm font-semibold">
                A
              </span>
              <div>
                <h4 class="text-sm font-medium text-white">Javier Arango (#5)</h4>
                <p class="text-xs text-[#A0ABB8]">Halcones Sintética · Acumulación de 3 tarjetas amarillas</p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-medium text-amber-300 bg-amber-500/20 px-2.5 py-1 rounded-full border border-amber-500/30">
                1 fecha de suspensión
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 4: Planilla digital -->
      <div id="tab-planilla" class="preview-panel hidden">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-[#606D80]/20">
          <div>
            <h3 class="text-base font-semibold text-white">Planilla arbitral móvil</h3>
            <p class="text-xs text-[#A0ABB8] mt-0.5">Diseñada para captura rápida desde el celular del árbitro</p>
          </div>
          <span class="text-xs font-medium text-[#567EBB] bg-[#2B4C7E]/40 px-3 py-1 rounded-full border border-[#567EBB]/30">
            Acta abierta
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-xl bg-[#1F1F20] border border-[#606D80]/25">
            <span class="text-xs text-[#A0ABB8] block mb-1">Tiempo de juego</span>
            <div class="text-2xl font-semibold text-white tabular-nums font-mono">78:42</div>
            <span class="text-xs text-[#567EBB] mt-1 block">+3' tiempo de adición</span>
          </div>

          <div class="p-5 rounded-xl bg-[#1F1F20] border border-[#606D80]/25">
            <span class="text-xs text-[#A0ABB8] block mb-1">Firmas de capitanes</span>
            <div class="text-sm font-medium text-white mt-2 flex items-center gap-2">
              <span class="text-[#567EBB]">✓</span> Local
              <span class="text-[#567EBB] ml-2">✓</span> Visitante
            </div>
            <span class="text-xs text-[#A0ABB8] mt-1 block">Validado con código de seguridad</span>
          </div>

          <div class="p-5 rounded-xl bg-[#1F1F20] border border-[#606D80]/25">
            <span class="text-xs text-[#A0ABB8] block mb-1">Cierre de encuentro</span>
            <div class="text-sm font-medium text-[#567EBB] mt-2">Exportar boletín oficial</div>
            <span class="text-xs text-[#A0ABB8] mt-1 block">Generación automática en PDF</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.preview-tab-btn');
  const panels = document.querySelectorAll('.preview-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      tabBtns.forEach(b => {
        b.classList.remove('active', 'text-[#1F1F20]', 'bg-white', 'shadow-sm');
        b.classList.add('text-[#A0ABB8]');
      });

      btn.classList.add('active', 'text-[#1F1F20]', 'bg-white', 'shadow-sm');
      btn.classList.remove('text-[#A0ABB8]');

      panels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });
</script>