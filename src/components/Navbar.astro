---
import { LINKS } from '../config';
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-colors">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-18">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center shadow-sm group-hover:bg-emerald-700 transition-colors">
          <img src="/logo-athletix.svg" alt="Athletix" class="w-5 h-5" />
        </div>
        <div class="flex items-center gap-2.5">
          <span class="text-lg font-bold tracking-tight text-slate-900 font-sans">
            Athletix
          </span>
          <span class="text-[11px] font-medium text-emerald-800 bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-full hidden sm:inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            Motor SIGET
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8 text-[13px] font-medium text-slate-600">
        <a href="#features" class="hover:text-slate-900 transition-colors">
          Cómo funciona
        </a>
        <a href="#preview" class="hover:text-slate-900 transition-colors">
          Demostración
        </a>
        <a href="#pricing" class="hover:text-slate-900 transition-colors">
          Planes y precios
        </a>
        <a href="#faq" class="hover:text-slate-900 transition-colors">
          Preguntas frecuentes
        </a>
        <a 
          href={LINKS.whatsappContact} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-emerald-700 hover:text-emerald-800 font-semibold transition-colors flex items-center gap-1.5"
        >
          <span>Soporte</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden md:flex items-center gap-3">
        <a 
          href={LINKS.login} 
          class="text-[13px] font-medium text-slate-700 hover:text-slate-900 px-3.5 py-2 transition-colors"
        >
          Iniciar sesión
        </a>
        <a 
          href={LINKS.register} 
          class="btn-green text-[13px] px-4 py-2 rounded-xl inline-flex items-center gap-1.5"
        >
          <span>Crear torneo gratis</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-btn"
          type="button" 
          aria-label="Abrir menú"
          class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-6 pt-3 pb-6 space-y-4 shadow-lg">
    <div class="flex flex-col space-y-3 text-[14px] font-medium text-slate-700">
      <a href="#features" class="mobile-nav-link hover:text-slate-900 py-1">Cómo funciona</a>
      <a href="#preview" class="mobile-nav-link hover:text-slate-900 py-1">Demostración en vivo</a>
      <a href="#pricing" class="mobile-nav-link hover:text-slate-900 py-1">Planes y precios</a>
      <a href="#faq" class="mobile-nav-link hover:text-slate-900 py-1">Preguntas frecuentes</a>
      <a href={LINKS.whatsappContact} target="_blank" rel="noopener noreferrer" class="mobile-nav-link text-emerald-700 font-semibold py-1">Soporte por WhatsApp</a>
    </div>
    <div class="pt-4 border-t border-slate-100 flex flex-col gap-2.5">
      <a 
        href={LINKS.login} 
        class="w-full text-center text-[13px] font-medium text-slate-800 py-2.5 rounded-xl border border-slate-300 bg-slate-50"
      >
        Iniciar sesión en SIGET
      </a>
      <a 
        href={LINKS.register} 
        class="w-full text-center text-[13px] btn-green py-2.5 rounded-xl"
      >
        Crear torneo gratis
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        hamburger.classList.add('hidden');
        close.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
      }
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
      });
    });
  }
</script>