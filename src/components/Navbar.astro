---
import { LINKS } from '../config';
---

<header class="sticky top-0 z-50 w-full bg-[#0B0D13]/85 backdrop-blur-xl border-b border-white/[0.06] transition-colors">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-18">
      
      <!-- Brand Monogram -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-lg bg-[#12151E] border border-white/[0.08] flex items-center justify-center group-hover:border-white/20 transition-colors shadow-sm">
          <img src="/logo-athletix.svg" alt="Athletix" class="w-5 h-5" />
        </div>
        <div class="flex items-center gap-2.5">
          <span class="text-base font-semibold tracking-tight text-white font-sans">
            Athletix
          </span>
          <span class="text-[11px] font-medium tracking-normal text-slate-400 bg-white/[0.04] border border-white/[0.06] px-2 py-0.5 rounded-full hidden sm:inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Motor SIGET
          </span>
        </div>
      </a>

      <!-- Desktop Nav: Clean, quiet, balanced -->
      <nav class="hidden md:flex items-center gap-8 text-[13px] font-medium text-slate-400">
        <a href="#features" class="hover:text-white transition-colors">
          Funcionalidades
        </a>
        <a href="#preview" class="hover:text-white transition-colors">
          Demostración
        </a>
        <a href="#pricing" class="hover:text-white transition-colors">
          Planes
        </a>
        <a href="#faq" class="hover:text-white transition-colors">
          Preguntas frecuentes
        </a>
        <a 
          href={LINKS.whatsappContact} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-emerald-400 transition-colors"
        >
          Soporte
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden md:flex items-center gap-3">
        <a 
          href={LINKS.login} 
          class="text-[13px] font-medium text-slate-300 hover:text-white px-3.5 py-1.5 rounded-full transition-colors"
        >
          Iniciar sesión
        </a>
        <a 
          href={LINKS.register} 
          class="btn-primary text-[13px] font-medium px-4 py-1.5 rounded-full inline-flex items-center gap-1.5"
        >
          <span>Crear torneo</span>
          <svg class="w-3.5 h-3.5 text-[#0B0D13]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-btn"
          type="button" 
          aria-label="Abrir menú"
          class="p-2 rounded-lg text-slate-400 hover:text-white focus:outline-none"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-white/[0.06] bg-[#0E1017] px-6 pt-3 pb-6 space-y-4">
    <div class="flex flex-col space-y-3 text-[14px] font-medium text-slate-300">
      <a href="#features" class="mobile-nav-link hover:text-white py-1">Funcionalidades</a>
      <a href="#preview" class="mobile-nav-link hover:text-white py-1">Demostración en vivo</a>
      <a href="#pricing" class="mobile-nav-link hover:text-white py-1">Planes y precios</a>
      <a href="#faq" class="mobile-nav-link hover:text-white py-1">Preguntas frecuentes</a>
      <a href={LINKS.whatsappContact} target="_blank" rel="noopener noreferrer" class="mobile-nav-link text-emerald-400 py-1">Soporte por WhatsApp</a>
    </div>
    <div class="pt-4 border-t border-white/[0.06] flex flex-col gap-2.5">
      <a 
        href={LINKS.login} 
        class="w-full text-center text-[13px] font-medium text-slate-200 py-2.5 rounded-xl border border-white/[0.08] bg-white/[0.02]"
      >
        Iniciar sesión en SIGET
      </a>
      <a 
        href={LINKS.register} 
        class="w-full text-center text-[13px] font-semibold text-black py-2.5 rounded-xl bg-white"
      >
        Crear torneo gratis
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        hamburger.classList.add('hidden');
        close.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
      }
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
      });
    });
  }
</script>