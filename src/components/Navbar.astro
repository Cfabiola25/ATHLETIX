---
import { LINKS } from '../config';
---

<header class="sticky top-0 z-50 w-full bg-[#080A0E]/95 backdrop-blur-md border-b border-[#1E2633]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo: Technical Athletic Brand -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-lg bg-[#0E121A] border border-[#1E2633] group-hover:border-[#CCFF00]/50 transition-colors flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 40 40" fill="none">
            <path d="M22 6L10 22H18L16 34L28 18H20L22 6Z" fill="#CCFF00"/>
          </svg>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-white uppercase font-sans">
            ATHLETIX
          </span>
          <span class="text-[10px] font-mono font-bold tracking-wider uppercase text-slate-400 bg-[#141A24] border border-[#1E2633] px-2 py-0.5 rounded">
            MOTOR SIGET
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-7 text-xs uppercase tracking-wider font-bold">
        <a href="#features" class="text-slate-400 hover:text-white transition-colors">
          Funcionalidades
        </a>
        <a href="#preview" class="text-slate-400 hover:text-white transition-colors">
          Tablero en Vivo
        </a>
        <a href="#pricing" class="text-slate-400 hover:text-white transition-colors">
          Precios
        </a>
        <a href="#faq" class="text-slate-400 hover:text-white transition-colors">
          Preguntas
        </a>
        <a 
          href={LINKS.whatsappContact} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-slate-400 hover:text-[#CCFF00] transition-colors flex items-center gap-1.5"
        >
          <span>Soporte</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#CCFF00] animate-pulse"></span>
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden md:flex items-center gap-3">
        <a 
          href={LINKS.login} 
          class="text-xs font-bold uppercase tracking-wider text-slate-300 hover:text-white px-3.5 py-2 rounded-lg bg-[#0E121A] border border-[#1E2633] hover:border-slate-600 transition-colors"
        >
          Ingresar
        </a>
        <a 
          href={LINKS.register} 
          class="btn-volt text-xs font-black uppercase tracking-wider px-4 py-2 rounded-lg flex items-center gap-1.5"
        >
          <span>Crear Torneo</span>
          <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>

      <!-- Mobile Button -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-btn"
          type="button" 
          aria-label="Abrir menú"
          class="p-2 rounded-lg text-slate-400 hover:text-white bg-[#0E121A] border border-[#1E2633] focus:outline-none"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#1E2633] bg-[#0B0E14] px-4 pt-3 pb-6 space-y-4">
    <div class="flex flex-col space-y-2.5 text-xs uppercase tracking-wider font-bold">
      <a href="#features" class="mobile-nav-link text-slate-300 hover:text-[#CCFF00] py-2 border-b border-[#1E2633]/50">Funcionalidades</a>
      <a href="#preview" class="mobile-nav-link text-slate-300 hover:text-[#CCFF00] py-2 border-b border-[#1E2633]/50">Tablero en Vivo</a>
      <a href="#pricing" class="mobile-nav-link text-slate-300 hover:text-[#CCFF00] py-2 border-b border-[#1E2633]/50">Precios</a>
      <a href="#faq" class="mobile-nav-link text-slate-300 hover:text-[#CCFF00] py-2 border-b border-[#1E2633]/50">Preguntas</a>
      <a href={LINKS.whatsappContact} target="_blank" rel="noopener noreferrer" class="mobile-nav-link text-[#CCFF00] py-2">Soporte WhatsApp</a>
    </div>
    <div class="pt-3 flex flex-col gap-2.5">
      <a 
        href={LINKS.login} 
        class="w-full text-center text-xs font-bold uppercase tracking-wider text-slate-200 py-2.5 rounded-lg border border-[#1E2633] bg-[#0E121A]"
      >
        Ingresar a SIGET
      </a>
      <a 
        href={LINKS.register} 
        class="w-full text-center text-xs font-black uppercase tracking-wider btn-volt py-3 rounded-lg"
      >
        Crear Torneo Gratis
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        hamburger.classList.add('hidden');
        close.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
      }
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
      });
    });
  }
</script>